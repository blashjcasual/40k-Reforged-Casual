          </constraints>
          <modifiers>
            <modifier affects="19a7-6d8e-9950-ac74" field="points" scope="unit" type="set" value="180">
              <conditions>
                <condition childId="model" childName="model" field="selections" includeChildSelections="true" scope="unit" shared="true" type="greaterThan" value="5"/>
              </conditions>
            </modifier>
            <modifier affects="19a7-6d8e-9950-ac74" field="error" scope="unit" type="add" value="{this} unit must have 5 or 10 models">
              <conditionGroups>
                <conditionGroup type="not">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="model" childName="model" field="selections" includeChildSelections="true" scope="unit" shared="true" type="equalTo" value="10"/>
                        <condition childId="model" childName="model" field="selections" includeChildSelections="true" scope="unit" shared="true" type="equalTo" value="5"/>
                      </conditions>
