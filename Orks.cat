          </modifiers>
        </infoLink>
        <infoLink name="Blast (X)" id="3b69-3e65-f22c-7a42" hidden="false" targetId="308a-e96e-90f7-855e" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Unrestrained" id="3061-fa87-5cf5-e92f" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Psychic Test made for this unit, add 1 D6 to that Psychic Test for each friendly ORK BOYZ unit in the battlefield.</characteristic>
          </characteristics>
        </profile>
        <profile name="Zzap" id="7661-6a0b-5e92-f061" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
          <characteristics>
            <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, roll a D3. Until the End step, if the result was 1, change this unit&apos;s Staff weapon’s Tp to CQ, or Aslt if it was 2, or Hv if it was 3. That weapon also gains Shred. until the End step.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Psychic Powers" id="0f12-5dc4-407e-9ee9" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="19b7-5f5c-c419-5514-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="19b7-5f5c-c419-5514-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="1 Jabbin’ Fingerz" id="9624-b9b2-780c-6b5a" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an infantry enemy unit within 16&quot; of and visible to this unit. The selected unit suffers D3 SW and until the end of the battle round, for each attack made by that unit, the Hit Roll of that attack is worsened by 1. 2&apos;ere We Go!: Until the next time this unit is Activated or dies, for each Move Roll made for your infantry units within 8&quot; of this unit, add 1 D6 to that Move Roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="2 ‘ere We Go!" id="17da-6df2-15cc-facd" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each Move Roll made for your infantry units within 8” of this unit, add 1 D6 to that Move Roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="3 Deyz Lucky" id="faef-e547-26cc-3b7b" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one of your infantry units within 12&quot; of this unit. Until the next time this unit is Activated or dies, for each attack that targets that unit, you may reroll a Resilient Roll for that attack.</characteristic>
              </characteristics>
            </profile>
            <profile name="4 Da Jump" id="b3dc-36f5-f41f-fc2d" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one of your infantry units within 12&quot; of this unit. Then, the selected unit may Reposition and add 3D6 to the Move Roll for that Reposition. For that move, the models may move over terrain and enemy models as if they were not there.</characteristic>
              </characteristics>
            </profile>
            <profile name="5 Iz Gonna Squig Ya" id="d2d6-a27f-1fa7-2479" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select one visible enemy unit within 16&quot; of this unit. The selected unit suffers 2D3 SW. Then, if one or more models die as a result of those SW, the selected unit suffers D6+2 SW.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Frazzle" id="d7e3-c08c-7f68-0ea5" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select one enemy unit within 16&quot; and visible to this unit and up to two enemy units within 8&quot; of that enemy unit. For each of the selected units, that unit suffers D6 SW.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Wierdboy" id="2dd6-1599-d666-b042" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="ba6a-7c8b-ba1f-0d9b-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="ba6a-7c8b-ba1f-0d9b-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Wierdboy" id="0434-82f8-020b-13bb" hidden="false" typeId="a706-96eb-fcae-b696" typeName="Unit">
              <characteristics>
                <characteristic name="T" typeId="a6ad-d820-8495-f5b0">2</characteristic>
                <characteristic name="Sv" typeId="9b7f-0dde-683f-6844">6+</characteristic>
                <characteristic name="H" typeId="18e4-1bf9-a9b8-1e50">7</characteristic>
                <characteristic name="Rv" typeId="411f-3942-6dc0-7c06">2+</characteristic>
              </characteristics>
            </profile>
            <profile name="Staff" id="5011-3507-ce1e-097a" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
              <characteristics>
                <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">ML</characteristic>
                <characteristic name="A" typeId="13c5-f234-c120-afc3">3</characteristic>
                <characteristic name="WS" typeId="459f-6890-e77f-b62f">3+</characteristic>
                <characteristic name="S" typeId="571c-0471-2614-c57c">4</characteristic>
                <characteristic name="D" typeId="c2c0-3714-05e2-65a0">1</characteristic>
                <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">This weapon has Blast X, where X is the highest dice result of this unit’s last Psychic Test.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
