      <profiles>
        <profile name="1 Banner of da WAAAAGH" id="a56e-10fa-376f-adea" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each attack any of your units make which targets an enemy unit within 8&quot; of this unit, that attack gains Critical Wounds 6+.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Fixa Uppaz" id="ed7b-3683-a162-bc33" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, select a friendly vehicle unit within 6&quot; of this unit. The selected unit Heals 2D3. Then, for each Health restored, all enemy units within 12&quot; of this unit suffer that many SW. 3&apos;UGE Choppa: After this unit is Activated, select one model in this unit. Until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Ain&apos;t Bovvered" id="234a-ef62-2c27-dd86" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While this unit has this ability, you may reroll Resilient rolls made for this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Dakka-Dakka-Dakka-Dakka" id="01a3-f1c6-af51-8b96" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each ranged attack made by this unit, a Hit Roll of 6 for that attack causes 2 additional hits.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Ol’ Boss’s Pincha" id="6083-acfc-331f-05bf" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit is Activated, select one model in this unit. Until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="3 ‘UGE Choppa" id="f798-c939-ee7e-759a" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit Activates, select one model in this unit. Until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="3 ‘UGE Choppa (Weapon)" id="4f85-acbd-6515-ec70" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
