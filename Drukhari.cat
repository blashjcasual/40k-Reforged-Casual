  <sharedProfiles>
    <profile name="Power from Pain" id="b06f-e1dd-55f1-f0e8" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 24&quot; of an enemy unit with Suppressed, it gains Resilient 6+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Herd the Prey" id="faa2-ab68-8bd3-d6ef" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Attacks step, this unit or a unit it is embarked within may Reposition. For that move&apos;s Move Roll, roll XD3 instead of 2D6, where X is the number of different enemy units with Suppressed in the battlefield.</characteristic>
      </characteristics>
    </profile>
    <profile name="Twisted Fleshcraft" id="59df-978c-0873-f611" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Resilient Roll made for this unit, add 2 to that roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Instruments of Torture" id="0128-cfa6-7815-0843" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While any enemy units with Suppressed X are within 12&quot; of this unit, for each Move Roll made for those units, that Move Roll&apos;s result is worsened by X (to a minimum of 0).</characteristic>
      </characteristics>
    </profile>
    <profile name="Lethal Celerity" id="0f7c-388c-93a3-aeaa" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 24&quot; of one or more enemy units with Suppressed, for each Move Roll made for this unit, roll an additional D6 and discard the lowest dice for that roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Graceful Acrobatics" id="245a-99df-d602-3b5a" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Attacks step, it may Reposition.</characteristic>
      </characteristics>
    </profile>
    <profile name="No Escape" id="aa49-2194-0e79-89d8" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Each time you Pile In this unit, each model may move an additional X” where X is the highest Suppressed X on any enemy unit within engagement range of this unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Arena Beasts" id="7a93-42c2-196d-e521" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">If this unit has a leader model, for each Move Roll made for this unit, roll an additional D6 for roll and discard the lowest result.</characteristic>
      </characteristics>
    </profile>
    <profile name="Grav-Engines" id="5859-caa5-7b1b-f8f1" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for this unit, add 1 D6 to that roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Slicing Skimmer" id="73a0-b916-aeb0-b906" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit finishes an Advance, if it is not within engagement range of any enemy units, make attacks with its Bladevanes targeting one enemy unit it passed within 1&quot; of during that Advance. Improve the A of its Bladevanes to 8 for those attacks.</characteristic>
      </characteristics>
    </profile>
    <profile name="Aethersail Agility" id="8fd5-76ff-fb31-918d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets this unit from further than 9&quot; away, the Hit Roll for that attack is worsened by 1.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Poison" id="dda4-31db-bf0a-2af4" hidden="false">
      <description>For each attack made for this weapon that targets an infantry or monster unit, a Hit Roll of 6+ for that attack causes that attack to always wound.</description>
    </rule>
  </sharedRules>
