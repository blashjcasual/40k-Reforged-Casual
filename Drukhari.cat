      <profiles>
        <profile name="Intoxicated Aerialists" id="ed6a-ee45-7cb7-26e6" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After you make a Move Roll for this unit, you may have it&apos;inject adrenalight&apos;. If you do, reroll that Move Roll. After this unit&apos;s End step, this unit suffers 1 Suppression for each time it injected adrenalight this turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Depraved Daredevils" id="4271-8617-d603-841a" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit finishes an Advance or Reposition within 1&quot; of a structure or obstacle terrain piece or a vehicle unit, this unit may Reposition. It may not do so again this turn for that terrain piece or unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
