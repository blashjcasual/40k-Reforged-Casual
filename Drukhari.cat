    <selectionEntry type="upgrade" import="true" name="Relics (Reference)" hidden="false" id="2462-79b7-2fea-37b4" sortIndex="-3">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="ebd8-1312-3e9f-a7e8" includeChildSelections="false" />
