      <profiles>
        <profile name="Speeding Skyboard" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="7b10-38c1-cdc6-e3fa">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for this unit, add 1 D6 to that roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master's Command" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="4374-d7d6-d3c1-e925">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While your CLAW ED FIENDS, RAZORW ING FLOCK, or KHYM ERAE units are within 16" of this unit, for each Move Roll made for those units, add 1 D6 to that roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Arena Trainer" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="ec77-1d65-471e-b4b1">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 1" of one or more of your CLAW ED FIENDS, RAZORW ING FLOCK, or KHYM ERAE units, for each attack that targets this unit, worsen the Hit Roll of that attack by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Crowd Favourite" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="0b16-f60a-430a-ad89">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit's End step, if this was your first turn in a row, you must take another turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
