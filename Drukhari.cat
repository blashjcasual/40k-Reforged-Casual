      </constraints>
      <categoryLinks>
        <categoryLink name="Configuration" hidden="false" id="f0bd-42f0-8375-cb3b" targetId="9cd6-0442-3f35-6b52" primary="true" />
      </categoryLinks>
      <profiles>
        <profile name="1 Splintermind Combat Drugs" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="935d-461d-d04a-2fcb">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each attack made for this unit, that attack gains Isolate, and reroll a Hit Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Painbringer Combat Drugs" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="f7d6-0e2b-0273-912f">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each Resilient Roll made for this unit, add 1 to that roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Raider's Plunder" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="85bd-f188-9dc3-f334">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit gains this ability, roll 2 D6. Then, select a relic from an opponent's army rules'relics table which matches any dice in that roll. Until this unit dies or loses that ability, your opponent cannot select that relic while capturing a vault. Then, this unit loses this ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 The Acquiescence" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="b951-4aff-b7bb-4ada">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit's Attacks step, for each enemy unit within 8" of this unit with Suppressed X, select up to X non-leader infantry models from that unit. Then, each selected model dies (is enslaved).</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Mask of the First Age" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="dcc9-cf74-17da-7cb6">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While enemy units are within 16" of this unit, those units'Rv is worsened by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Phantasm Grenades" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="1d3c-852e-efd2-e0f5">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit's Move step, select an enemy unit within 12" of and visible to this unit. Until the End step, for each Resolve Test the selected unit succeeds, it suffers 1 SW. Then, the selected enemy unit suffers 2D6 Suppression.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Isolate" id="6c98-0faa-2c15-3ce9" hidden="false" type="rule" targetId="db97-d77e-4392-6f10" />
        <infoLink name="Suppressive (X)" id="6994-8ba1-3a32-c2b0" hidden="false" type="rule" targetId="aed3-e154-8fa2-5378" />
