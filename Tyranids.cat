    <selectionEntry type="unit" import="true" name="Toxicrene" hidden="false" id="4f4d-7a46-35f1-e831" sortIndex="1">
      <costs>
        <cost name="pts" typeId="points" value="170" />
      </costs>
      <categoryLinks>
        <categoryLink targetId="ccc6-6202-853c-23e4" id="6bf2-8f85-c7e5-ee6f" primary="true" name="Support" />
        <categoryLink targetId="6537-7b2d-b2c8-6005" id="c58c-50bb-9813-d667" primary="false" name="Monster" />
      </categoryLinks>
      <profiles>
        <profile name="Billowing Chimneys" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="18e4-0d01-bd80-4de4">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While enemy infantry or monster units are within 12" of this unit, those units gain the following ability:</characteristic>
          </characteristics>
        </profile>
        <profile name="After the Move step of an enemy TOXICRENE unit" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="1fe5-1805-9b85-259a">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">within 12" of this unit, or after this unit's Move step, this unit suffers 4+D3 SW.</characteristic>
          </characteristics>
        </profile>
        <profile name="Toxic Spores" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="5811-29ff-e68d-90a6">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit's Attacks step, each enemy unit within 12" of this unit suffers 2+D3 Suppression.</characteristic>
          </characteristics>
        </profile>
        <profile name="Grasping Tentacles" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="3759-a097-2e33-b779">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While enemy units are within 8" of this unit, those units gain the following ability:</characteristic>
          </characteristics>
        </profile>
        <profile name="Entangled" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="c5c3-1c7f-3079-869b">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for this unit, roll one fewer dice for that roll. When determining line of sight and measuring the distance to and from this model, it is highly recommended you do not count this model's tentacles as'part of the model'.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Walker" id="9a30-ade6-4ce9-1130" hidden="false" type="rule" targetId="4100-8e8c-47a5-3a15" />
      </infoLinks>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Toxicrene" hidden="false" id="ba77-3ac9-ac87-048a">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="ba77-3ac9-ac87-048a-min" includeChildSelections="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ba77-3ac9-ac87-048a-max" includeChildSelections="false" />
          </constraints>
