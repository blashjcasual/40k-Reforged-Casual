          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After the end of each battle round, you may remove this unit from the battlefield and place it into reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="Horror of the Deep" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="d103-5888-c48c-3f26">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is in reserves, after an enemy unit's Move step, as a reaction, if that unit does not have Fly, roll a D6. On a 4+, you may Deploy this unit within 6" of that enemy unit and outside of the engagement range of enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Roiling Serpent" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="ef04-bfa5-483b-4e2a">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each ranged attack targeting this unit, the Hit Roll for that attack is worsened by 1.</characteristic>
          </characteristics>
        </profile>
