        <profile name="Emerging Swarm" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="ad2b-0cf7-6fba-60ab">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After you Deploy this unit, you may select one of your infantry units in reserves. Deploy the selected unit wholly within 6" of this unit outside of the engagement range of enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Horror of the Deep" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="9702-d0e1-33c2-5934">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is in reserves, after an enemy unit's Move step, as a reaction, if that unit does not have Fly, roll a D6. On a 4+, you may Deploy this unit within 6" of that enemy unit and outside of the engagement range of enemy units.</characteristic>
          </characteristics>
        </profile>
