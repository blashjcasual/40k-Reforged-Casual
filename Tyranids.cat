          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">The attacks of this unit's Bio-Plasma Discharge weapon improve equal to the discarded dice.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rampaging Assault" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="0dec-4f18-ae0a-cbbc">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This attack of this unit's Screamer Scything Talons is improved equal to the highest dice of that Move Roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ululating Shriek" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="474b-06b6-bbbc-085b">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After selecting targets for this unit's weapons, all enemy units within XD3" suffer X Suppression where X is equal to this unit's Bioplasma Discharge weapon's attacks. If X is greater than 4, those units suffer X SW instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
