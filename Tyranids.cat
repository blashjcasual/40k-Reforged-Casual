      <profiles>
        <profile name="Seismic Senses" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="902c-b64b-e10b-79d6">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is in reserves, after an enemy unit's Move step, as a reaction, if that unit does not have Fly, roll 2D6. Then, if there are no other enemy units within X" of the active unit where X is the result of that roll, that unit gains the following ability until the End step of your next turn:</characteristic>
          </characteristics>
        </profile>
        <profile name="Isolated Tremors" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="e3ff-fea6-fd8f-af76">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After an enemy RAVENERS unit is Activated while that unit is in reserves, that unit may Deploy within engagement range of this unit. If it does, during this turn's Move step, that unit does not make a Move Roll and cannot Advance or Reposition.</characteristic>
          </characteristics>
        </profile>
        <profile name="Voracious Cull" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="624d-a9d9-266b-095a">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit destroys an enemy unit, if this unit has Hive</characteristic>
          </characteristics>
        </profile>
        <profile name="Subterranean Withdrawal" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="3680-c8b7-f1c2-92f6">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any enemy unit's End step, you may remove this unit from the battlefield and place it into reserves. If you do, it loses this ability.</characteristic>
          </characteristics>
        </profile>
      </profiles>
