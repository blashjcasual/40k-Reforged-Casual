        </profile>
        <profile name="Synaptic Apex" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="faa4-008f-6caf-f1f2">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Once per battle round, after the End step for one of your units with Hive Minded, if this turn was your first turn in a row, you may take another turn.</characteristic>
