      <profiles>
        <profile name="Vigilant Presidio" id="47b2-d9eb-20d9-a0b9" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Once per turn, while an enemy unit is active, after any of your units within 1&quot; of this unit performs a technique, this unit may perform a technique.</characteristic>
          </characteristics>
        </profile>
        <profile name="Stand Watch" id="eebf-bd3a-4a2d-00a1" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">During an Advance, this unit may move up to an additional 6” if that move would end within 1” of a friendly infantry unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Binding Oath" id="f8f7-16e1-7fed-b3b1" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While other friendly infantry units are within 1” of this unit and, this unit is closer or the same distance to an active enemy unit visible to this unit, those friendly infantry units gain the following ability:

Guarded: For each wound a model in this unit is selected to suffer, you may roll a D6. On a 5+, that attack fails.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
