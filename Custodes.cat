      <infoLinks>
        <infoLink name="Pierce" id="eece-f168-dc32-dff2" hidden="false" targetId="f61d-729a-ad35-ab97" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="1 Praetorian Shield" id="5c2e-74a3-336e-baf9" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After a model in this unit is selected to suffer a wound, roll a D6. On a 5+, the Saving Throw for that attack always succeeds.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Solarite Heart-Node" id="0b6c-0cf9-fb5f-9232" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each Move Roll made for this unit, add 1 D6 to that Move Roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Gatekeeper" id="c609-983f-eb32-38a7" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit is Activated, select one model in this unit. Until the End step, the selected model gains the following weapons:</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Fulminaris Vexilla" id="e136-a80f-ead2-bcad" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit finishes an Advance, each enemy unit within 8” suffers 3+D3 SW.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Stasis Oubliette" id="24b6-3ace-5ab6-ea27" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While enemy units are within 4” of this unit, those units cannot be selected for Activation unless their controlling player has no other units available for Activation.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Misery’s Burden" id="e512-f8c7-47d2-ce75" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">Each time you roll a D6 for Kaptaris Parry for this unit, add 1 to the result. For each attack this unit makes, that attack gains Critical Wounds 6+.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Gatekeeper Bolter" id="122d-6c17-486a-4b2f" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">CQ</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">6</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">1+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">3</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">1</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">For each attack made for this weapon, a Hit Roll of 6 for that attack causes an additional hit.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Gatekeeper Spear" id="c454-98f4-5460-95db" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">ML</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">2</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">1+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">4</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">2</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Pierce, for each attack made for this weapon, a Hit Roll of 6 for that attack causes an additional hit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
