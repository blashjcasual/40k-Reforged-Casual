  <sharedProfiles>
    <profile name="WAAAGH!" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="c9f0-afe5-0f2c-c9b1">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While your infantry units are within 12” of this unit, they gain the following ability:

WAAAAGH!: For each attack that targets this unit, reroll Resilient Rolls of 1 for that attack. If there are two or more other friendly Orks units within 12” of this unit, reroll failed Resilient Rolls for that attack instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Solid Greenskin" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="c35f-6848-d4c4-faeb">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit's T is improved by 1 (already noted in bold on its profile). This unit cannot be in cover for enemy attacks. For each SW this unit suffers, it gains Resilient 5+ for that attack or if it already has Resilient, instead add 1 to Resilient Rolls for that attack.</characteristic>
      </characteristics>
      <modifiers>
        <modifier type="increment" value="1" field="a6ad-d820-8495-f5b0" scope="unit-self" affects="self.entries.recursive.profiles.Unit"/>
      </modifiers>
    </profile>
    <profile name="Ge’ In Dere!" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="ad82-3c2d-6494-820e">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s End step, if this turn was not your second turn in a row, you may take another turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dats Be’a" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="8111-4d6b-4a50-773c">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit's Move step, you may select a vehicle unit within 4" of this unit or a unit it is embarked within. The selected unit Heals D3+1.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
