          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets this unit while this unit is your closest unit to the attacking unit, reroll failed Resilient Rolls for that attack.</characteristic>
          </characteristics>
