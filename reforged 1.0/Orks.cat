    <selectionEntry type="unit" import="true" name="Wierdboy" hidden="false" id="2501-2c1d-0736-590e" sortIndex="13">
      <costs>
        <cost name="pts" typeId="points" value="80"/>
      </costs>
      <categoryLinks>
        <categoryLink targetId="4820-e2b5-9e00-bb68" id="74c4-0e73-f7e0-d07f" primary="true" name="Elites"/>
        <categoryLink targetId="205c-3072-067b-d808" id="d42e-2930-0fc6-b29d" primary="false" name="Infantry"/>
      </categoryLinks>
      <profiles>
        <profile name="Unrestrained" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="3061-fa87-5cf5-e92f">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Psychic Test made for this unit, add 1 D6 to that Psychic Test for each friendly ORK BOYZ unit in the battlefield.</characteristic>
          </characteristics>
        </profile>
        <profile name="Zzap" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp" hidden="false" id="7661-6a0b-5e92-f061">
          <characteristics>
            <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, roll a D3. Until the End step, if the result was 1, change this unit&apos;s Staff weapon’s Tp to CQ, or Aslt if it was 2, or Hv if it was 3. That weapon also gains Shred. until the End step.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Solid Greenskin" id="7e82-9162-b419-ade1" hidden="false" type="profile" targetId="c35f-6848-d4c4-faeb"/>
        <infoLink name="Resilient (X)" id="c42a-9ac8-d3d9-5b35" hidden="false" type="rule" targetId="253c-c1fa-d29d-d21e">
          <modifiers>
            <modifier type="set" value="Resilient (5+)" field="name"/>
          </modifiers>
        </infoLink>
        <infoLink name="Psyker (X)" id="8471-dcd2-f01b-5c2f" hidden="false" type="rule" targetId="6ff7-e000-c4c9-fb18">
          <modifiers>
            <modifier type="set" value="Psyker (1)" field="name"/>
          </modifiers>
        </infoLink>
        <infoLink name="Blast (X)" id="3b69-3e65-f22c-7a42" hidden="false" type="rule" targetId="308a-e96e-90f7-855e"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Psychic Powers" hidden="false" id="0f12-5dc4-407e-9ee9">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="19b7-5f5c-c419-5514-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="19b7-5f5c-c419-5514-max" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="1 Jabbin’ Fingerz" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="9624-b9b2-780c-6b5a">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an infantry enemy unit within 16" of and visible to this unit. The selected unit suffers D3 SW and until the end of the battle round, for each attack made by that unit, the Hit Roll of that attack is worsened by 1. 2'ere We Go!: Until the next time this unit is Activated or dies, for each Move Roll made for your infantry units within 8" of this unit, add 1 D6 to that Move Roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="2 ‘ere We Go!" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="17da-6df2-15cc-facd">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each Move Roll made for your infantry units within 8” of this unit, add 1 D6 to that Move Roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="3 Deyz Lucky" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="faef-e547-26cc-3b7b">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one of your infantry units within 12" of this unit. Until the next time this unit is Activated or dies, for each attack that targets that unit, you may reroll a Resilient Roll for that attack.</characteristic>
              </characteristics>
            </profile>
            <profile name="4 Da Jump" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="b3dc-36f5-f41f-fc2d">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one of your infantry units within 12" of this unit. Then, the selected unit may Reposition and add 3D6 to the Move Roll for that Reposition. For that move, the models may move over terrain and enemy models as if they were not there.</characteristic>
              </characteristics>
            </profile>
            <profile name="5 Iz Gonna Squig Ya" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="d2d6-a27f-1fa7-2479">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select one visible enemy unit within 16" of this unit. The selected unit suffers 2D3 SW. Then, if one or more models die as a result of those SW, the selected unit suffers D6+2 SW.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Frazzle" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="d7e3-c08c-7f68-0ea5">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select one enemy unit within 16" and visible to this unit and up to two enemy units within 8" of that enemy unit. For each of the selected units, that unit suffers D6 SW.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Wierdboy" hidden="false" id="2dd6-1599-d666-b042">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="ba6a-7c8b-ba1f-0d9b-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ba6a-7c8b-ba1f-0d9b-max" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="Wierdboy" typeId="a706-96eb-fcae-b696" typeName="Unit" hidden="false" id="0434-82f8-020b-13bb">
              <characteristics>
                <characteristic name="T" typeId="a6ad-d820-8495-f5b0">2</characteristic>
                <characteristic name="Sv" typeId="9b7f-0dde-683f-6844">6+</characteristic>
                <characteristic name="H" typeId="18e4-1bf9-a9b8-1e50">7</characteristic>
                <characteristic name="Rv" typeId="411f-3942-6dc0-7c06">2+</characteristic>
              </characteristics>
            </profile>
            <profile name="Staff" typeId="2dff-53d0-6d25-8c59" typeName="Weapon" hidden="false" id="5011-3507-ce1e-097a">
              <characteristics>
                <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">ML</characteristic>
                <characteristic name="A" typeId="13c5-f234-c120-afc3">3</characteristic>
                <characteristic name="WS" typeId="459f-6890-e77f-b62f">3+</characteristic>
                <characteristic name="S" typeId="571c-0471-2614-c57c">4</characteristic>
                <characteristic name="D" typeId="c2c0-3714-05e2-65a0">1</characteristic>
                <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">This weapon has Blast X, where X is the highest dice result of this unit’s last Psychic Test.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
