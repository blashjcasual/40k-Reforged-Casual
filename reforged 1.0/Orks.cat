      <profiles>
        <profile name="Da Boyz’ Waaaghcry" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="49a9-6395-24e1-0f8d">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While your units are within 16” of this unit, they gain the following ability:


Green Tide X: For each Move Roll made for this unit, roll X additional D6s, where X is the number of units with Da Boyz’ Waaaghcry within 16” of this unit. For each additional dice added, remove one of the lowest dice from that roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Get Da Good Bitz" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="5f3d-e588-9eae-0bd0">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit's End step, if this unit is not within 4" horizontally of an objective, this unit may capture an objective that it passed within 4" horizontally of this turn (capture rules still apply).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
