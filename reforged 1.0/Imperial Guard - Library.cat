      <profiles>
        <profile name="Modian Command Centre" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="dec8-a3c4-a5ad-e949">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is embarked in a transport, that transport gains all of this unit&apos;s abilities.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mordian Regimental Order" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="bae7-737c-6f61-3bb2">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit and your other Imperial Guard infantry units within 24" of this unit gain the following ability: Form Up!: After any unit is Activated, draw a line parallel to the front edge of your deployment zone between any two points on the battlefield edge. Each unit with Form Up! that line passes through is'forming the line'until the End step. While three or more units are forming the line, for each attack that targets those units, you may reroll failed Saving Throws for that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Heavy Armour" id="ba4e-0766-8db9-300a" hidden="false" type="rule" targetId="ec2c-77fd-05f2-a794">
