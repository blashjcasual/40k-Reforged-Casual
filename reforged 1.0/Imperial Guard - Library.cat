      <profiles>
        <profile name="No Retreat" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="8553-2025-1a80-b158">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit Activates while in engagement range of any enemy units, each of this unit's Aslt weapons may have their Tp changed to CQ until the End step.</characteristic>
          </characteristics>
        </profile>
        <profile name="Drilled Fire" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="e27f-b6b9-70ac-33e1">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While each of this unit's models are touching another model in this unit, for each ranged attack made by another friendly Imperial Guard unit that targets an enemy unit within 24" of this unit, reroll a Hit Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
