      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Explosive Mines" hidden="false" id="fd81-7c45-3b14-4dce">
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0ff9-1a20-03eb-7bdb" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="Explosive Mines" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="037a-c0f8-340e-f9dc">
              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After an enemy unit finishes an Advance and is within 18” of this unit, you may roll 3D6. If that unit is within X” of this unit where X is equal to the result of that roll, roll a D6 and if that unit finished that Advance within engagement range of any friendly units, add 1 to that roll. On a 5+, that unit suffers 5 Suppression.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Suppressive (X)" id="4696-a086-154c-6aee" hidden="false" type="rule" targetId="aed3-e154-8fa2-5378"/>
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
      <profiles>
        <profile name="Surprise Raids" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="a340-7787-ab25-f443">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit's End step, if this turn was your first turn in a row, you may take another turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tunnelling" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="8ca8-0b5d-e56c-48c9">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated, you may remove it from the battlefield. If you do, roll 2D6. Then, Deploy this unit anywhere in the battlefield surface area within X inches of any of your other infantry units with Entrench, where X is equal to the result of that roll. Then, you may select one of your infantry units in reserves and Deploy the selected unit wholly within 6" of this unit outside of the engagement range of enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Death Korps Platoon Commander" hidden="true" id="03e3-17a9-14d9-64d1">
      <costs>
        <cost name="pts" typeId="points" value="10"/>
      </costs>
      <categoryLinks>
        <categoryLink targetId="205c-3072-067b-d808" id="057d-2517-7bf4-a42e" primary="false" name="Infantry"/>
        <categoryLink targetId="2886-2afd-f65f-9d8e" id="d537-72fa-6b00-87a4" primary="true" name="Leaders"/>
      </categoryLinks>
      <profiles>
        <profile name="Death Korps Regimental Orders" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="ab63-5acf-851c-1c9a">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit and your other Astra Militarum infantry units within 24” gain the following abilities: Hold The Line: For each of this unit&apos;s ranged attacks, reroll a Wound Roll of 1 for that attack. Over The Top: For each Move Roll made for this unit, you may reroll that roll. After this unit makes a Move Roll, until the End step, it gains the following ability: Duty To The Emperor: For each melee attack this unit makes, a Wound Roll of 6 for that attack causes an additional wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Look Out Sir!" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="fa28-44cb-adfd-f4d3">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While one or more of your units with Entrench are within 6&quot; of and visible to this unit, for each ranged or SW attack that targets this unit, you may change the Sv of this unit to 2+ for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile typeId="55da-e0a0-1fa3-2d1c" typeName="Leader" hidden="false" id="8bbd-05c9-b245-7367">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit cannot attach to anything.</characteristic>
          </characteristics>
        </profile>
        <profile name="Death Korps Command Centre" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="7205-e4bb-26e1-0bd6">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is embarked in a transport, that transport gains all of this unit's abilities and loses Look Out Sir!.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Resilient (X)" id="73d9-0b95-c124-7f60" hidden="false" type="rule" targetId="253c-c1fa-d29d-d21e">
          <modifiers>
            <modifier type="set" value="Resilient (6+)" field="name"/>
          </modifiers>
        </infoLink>
      </infoLinks>
