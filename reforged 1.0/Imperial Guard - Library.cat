    <selectionEntry type="unit" import="true" name="Cadian Platoon Commander" hidden="true" id="7797-0a49-618c-60ad">
      <costs>
        <cost name="pts" typeId="points" value="10"/>
      </costs>
      <categoryLinks>
        <categoryLink targetId="2886-2afd-f65f-9d8e" id="0146-e07f-d8d0-cded" primary="true" name="Leaders"/>
        <categoryLink targetId="205c-3072-067b-d808" id="30a9-79b3-7911-0388" primary="false" name="Infantry"/>
      </categoryLinks>
      <profiles>
        <profile name="Cadian Command Centre" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="f92e-f1fc-1487-3654">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is embarked in a transport, that transport gains all of this unit's abilities.</characteristic>
          </characteristics>
        </profile>
        <profile typeId="55da-e0a0-1fa3-2d1c" typeName="Leader" hidden="false" id="0dfa-f5b7-16f7-f527">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit cannot attach to anything.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cadian Regimental Orders" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="fbca-3b91-a35a-916c">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit and your other Imperial Guard infantry units within 24" of this unit, those units gain the following abilities: Hold, On My Command!: After a Move Roll made for this unit during its Move step, you may discard the highest result of that Move Roll. If you do, skip your Attacks step. Then, until the end of the battle round, after each of your Move steps, you may make ranged attacks with this unit. If you do, after the End step, this unit loses this ability. First Rank, Fire! Second Rank, Fire!: For each ranged attack this unit makes, if this is your second turn in a row, a Hit Roll of 6 causes an additional hit. For each of those attacks that target an enemy unit which lost one or more health last turn, add 1 to that Hit Roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
