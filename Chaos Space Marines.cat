      <profiles>
        <profile name="Hateful Annihilation" id="1ff3-74e3-3009-5881" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack made for this unit that targets an enemy unit with Dark Gods&apos;Hatred, reroll a Hit Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hail of Fire" id="fa4b-55e5-ebc6-1b2d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit selects targets for its attacks, if two or more enemy units were selected as targets for those attacks, those attacks gain Critical Hits 6+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
