      <profiles>
        <profile name="Successful Hunt" id="199c-9568-1d55-309f" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit destroys an enemy unit, it gains the following ability:


Slice Dimensions: After any enemy unit&apos;s End step, you may remove this unit from the battlefield and place it into reserves. If you do, it loses this ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Immaterial Predators" id="2757-8066-d4c1-db40" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated in reserves, you may roll 3D6 and select an enemy unit with Dark Gods&apos;Hatred. You may Deploy this unit anywhere in the battlefield at least X&quot; away from all enemy units other than the selected unit where X is the result of that roll. If you do, this unit cannot Advance or Reposition this turn and until the End step, this unit&apos;s weapons gain Isolate.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Warp Talons" id="12a1-a95a-dcd2-0b4c" defaultSelectionEntryId="81b7-c742-0be2-3a3b" hidden="false">
