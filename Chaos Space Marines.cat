        <profile name="6 Techno-Venomous Mechatendrils" id="1f9b-a7d1-39e5-0f7b" hidden="true" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <comment>Iron Warriors</comment>
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While enemy units are visible to and within 8” of this unit, those units gain the following ability: 


Structural Degradation: This unit cannot be selected for Activation unless their controlling player has no other units available for Activation. Additionally, for each attack that targets this unit, a Hit Roll of 6 for that attack always wounds.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="27b0-cf36-cd17-73c6" childName="Iron Warriors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="5 Destruction Doctrine" id="838a-3dec-273a-de0d" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Iron Warriors</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, you may select a visible structure or obstacle. All enemy units within 2&quot; of the selected terrain piece suffer D6+1 SW. If any of your models within 24&quot; of and visible to the selected terrain piece is equipped with a Hv weapon, those enemy units suffer 2D6+1 SW instead. Then, if there are no enemy models on that terrain piece, remove it from the battlefield.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="27b0-cf36-cd17-73c6" childName="Iron Warriors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="4 Siegebreaker Mace" id="3435-1ee6-a36e-c1e3" hidden="true" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <comment>Iron Warriors</comment>
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">ML</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">3</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">3+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">6</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">2D3+1</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Breach, This unit may move over terrain as if they were not there. 


Once per turn, after a successful Wound Roll for an attack made for this weapon, select another enemy unit within 6” of and visible to the target unit of that attack. The selected enemy unit suffers 1+2D3 SW.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="27b0-cf36-cd17-73c6" childName="Iron Warriors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="3 Hindering Mecha-Serpents" id="772f-e68a-8f51-8a10" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Iron Warriors</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, select one enemy unit within 16&quot; of and visible to this unit. That unit suffers D6+3 Suppression, and gains the following ability:

Constricted: For each Move Roll made for this unit, roll 1 less D6 for that roll. If this unit does not have Suppressed, it loses this ability.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="27b0-cf36-cd17-73c6" childName="Iron Warriors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="2 Fleshmetal Exoskeleton" id="2fcc-1ceb-d971-87cd" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Iron Warriors</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While this unit has this ability, it gains Heavy Armour. If it already has Heavy Armour, its Toughness is improved by 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="27b0-cf36-cd17-73c6" childName="Iron Warriors" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="1 Drakescale Plate" id="b1c5-1955-2ce4-b73f" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Alpha Legion</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">This unit gains Resilient 5+.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="d592-5a78-0580-1d03" childName="Alpha Legion" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="6 Bereft of Mercy" id="6835-d6ca-cd7d-647e" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Night Lords</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Attacks step, if any models in an enemy unit within engagement range of this unit died during this turn, if that enemy unit has Suppressed X, each enemy unit within 12&quot; of and visible to that enemy unit suffers X Suppression. After any enemy unit with Suppressed X within engagement range of this unit is destroyed, each enemy unit within 12&quot; of this unit suffers 2 Suppression.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="1fa8-6666-7875-be1b" childName="Night Lords" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="5 Talons of the Night Terror" id="c8b9-7071-aa05-ca47" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Night Lords</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, roll 1+D3. Then, all enemy infantry units within engagement range of this unit suffer X Suppression and X SW where X is equal to that roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="1fa8-6666-7875-be1b" childName="Night Lords" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="4 Vox Daemonicus" id="a6d6-229f-a5e4-512a" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Night Lords</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, select an enemy unit within 8&quot; of and visible to this unit and roll 3D3. That roll is X. Then, select a second enemy unit within X&quot; of and visible to the first, and a third within X&quot; of and visible to the second, and so on for any number of enemy units. Each enemy unit can only be selected once, and you can stop selecting at any time. Then, each selected unit suffers 2 Suppression.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="1fa8-6666-7875-be1b" childName="Night Lords" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="3 Stormbolt Plate" id="af1c-0119-5f80-a94c" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Night Lords</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After the End step of your turns, if this unit is within 12&quot; of an enemy unit with Suppressed, this unit may Reposition.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="1fa8-6666-7875-be1b" childName="Night Lords" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="2 Claws of the Black Hunt" id="fd35-db01-833b-ef04" hidden="true" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <comment>Night Lords</comment>
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">ML</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">8</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">2+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">2</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">1</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Shred, Pierce For each attack made for this weapon which targets a unit with Suppressed, add 1 to the Hit Roll of that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
