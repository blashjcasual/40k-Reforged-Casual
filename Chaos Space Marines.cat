      <profiles>
        <profile name="Successful Hunt" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="199c-9568-1d55-309f">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit destroys an enemy unit, it gains the following ability:


Slice Dimensions: After any enemy unit's End step, you may remove this unit from the battlefield and place it into reserves. If you do, it loses this ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Immaterial Predators" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="2757-8066-d4c1-db40">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated in reserves, you may roll 3D6 and select an enemy unit with Dark Gods'Hatred. You may Deploy this unit anywhere in the battlefield at least X" away from all enemy units other than the selected unit where X is the result of that roll. If you do, this unit cannot Advance or Reposition this turn and until the End step, this unit's weapons gain Isolate.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="f809-9826-f58a-6b8d" id="8b3e-93b8-15d5-0c16" primary="false" name="Chaos" />
