        <entryLink name="Heavy Flamer" id="36ce-b2ed-ee3d-01c3" hidden="false" import="true" targetId="0e49-4f67-14a9-ad0c" type="selectionEntry"/>
        <entryLink name="Meltagun" id="15ce-7aea-ff4f-ff52" hidden="false" import="true" targetId="3e64-4706-d7e4-3c17" type="selectionEntry"/>
        <entryLink name="Plasma Blaster" id="3c10-2da1-41b2-5267" hidden="false" import="true" targetId="99f9-3972-a2ac-88f8" type="selectionEntry"/>
        <entryLink name="Cyclone Missiles" id="f704-bb4d-10f7-4a5a" hidden="false" import="true" targetId="241d-c374-f065-9144" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Walker" id="960a-711d-7e67-7a4b" hidden="false" targetId="4100-8e8c-47a5-3a15" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Ancient&apos;s Wisdom" id="899d-e029-ed7f-8522" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Resolve Test made for your units within 12&quot; of this unit, reroll a result of 1 for that Resolve Test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Chaos Contemptor Dreadnought" id="d875-b552-104e-70d4" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="d875-b552-104e-70d4-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="d875-b552-104e-70d4-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Chaos Contemptor Dreadnought" id="809c-1f5c-a663-981a" hidden="false" typeId="a706-96eb-fcae-b696" typeName="Unit">
              <characteristics>
                <characteristic name="T" typeId="a6ad-d820-8495-f5b0">4</characteristic>
                <characteristic name="Sv" typeId="9b7f-0dde-683f-6844">3+</characteristic>
                <characteristic name="H" typeId="18e4-1bf9-a9b8-1e50">13</characteristic>
                <characteristic name="Rv" typeId="411f-3942-6dc0-7c06">6+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
  </sharedSelectionEntries>
  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Leader" id="9c2e-ecf5-96b0-f116" hidden="false">
      <comment>Sorcerer</comment>
      <constraints>
        <constraint id="962b-b7f8-99e1-3f1c" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <entryLinks>
        <entryLink name="Legionaries" id="f0e9-2f33-8f75-26b6" hidden="false" import="true" sortIndex="1" targetId="286f-70e0-ffba-da53" type="selectionEntry"/>
        <entryLink name="Cultists" id="9e16-78a0-5c1c-8427" hidden="false" import="true" sortIndex="2" targetId="e6fe-5cc9-bb21-2430" type="selectionEntry"/>
        <entryLink name="Chosen" id="e142-2994-7f96-f2f4" hidden="false" import="true" sortIndex="3" targetId="970c-0d8e-c281-ed7b" type="selectionEntry"/>
      </entryLinks>
    </selectionEntryGroup>
    <selectionEntryGroup name="Chaos Disciple" id="ff07-25ed-c9db-0945" defaultSelectionEntryId="e351-8cb4-3322-b80b" hidden="false">
      <constraints>
        <constraint id="516b-2d85-ce9f-2ffd-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="516b-2d85-ce9f-2ffd-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Disciple of Nurgle" id="f416-1e6c-eb17-4a97" hidden="false" import="true" sortIndex="2" type="upgrade">
          <infoLinks>
            <infoLink name="Resilient (X)" id="ac9b-00b2-481c-bbaf" hidden="false" targetId="253c-c1fa-d29d-d21e" type="rule"/>
            <infoLink name="Suppressive (X)" id="5020-cd26-4dfc-6dc8" hidden="false" targetId="aed3-e154-8fa2-5378" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="1 Shriveling Pox" id="5adc-374e-13e4-4929" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy unit within 14&quot; of this unit. Until the End step, the selected unit&apos;s Toughness is worsened by 1. If the selected unit is within 7&quot;, its Toughness is worsened by 2 instead.</characteristic>
              </characteristics>
            </profile>
            <profile name="2 Dance for the Grandfather" id="29cc-a3c6-0832-f044" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy infantry or monster unit within 16&quot; of and visible to this unit. Until the End step, for each attack that targets that unit this turn, reroll a failed Hit Roll for that attack.</characteristic>
              </characteristics>
            </profile>
            <profile name="3 Pestilent Miasma" id="7dbf-8fd2-b9b8-1ff4" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each Move Roll made for an enemy unit while that unit is within 14&quot; of this unit, they must discard the highest result of the 2 D6.</characteristic>
              </characteristics>
            </profile>
            <profile name="4 Aura of Decay" id="59d8-4c23-536b-eb91" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, after any enemy unit is Activated within 7&quot; of this unit, that unit suffers 1+D3 Suppression.</characteristic>
              </characteristics>
            </profile>
            <profile name="5 Fleshy Abundance" id="ec48-8bed-5e7d-6a36" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a friendly unit within 14&quot; of this unit. Until the next time this unit is Activated or dies, the selected unit gains Resilient 6+ and the following ability:</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Rancid Visitations" id="1480-9066-a62c-28f8" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy unit within 14&quot; of and visible to this unit. The selected unit suffers D3+3 Suppression. If the selected unit is within 7&quot;, it suffers 2D3+3 Suppression instead.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Disciple of Slaanesh" id="ed37-5f6a-c35d-ccce" hidden="false" import="true" sortIndex="3" type="upgrade">
          <infoLinks>
            <infoLink name="Suppressive (X)" id="4558-1a50-ba7b-5a86" hidden="false" targetId="aed3-e154-8fa2-5378" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="1 Cacophonic Choir" id="3721-f0e3-3c3f-49a4" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the End step, for each Resolve Test made for enemy units within 6&quot; of this unit, a result of 6 for that Resolve Test always fails. Then, each enemy unit within 6&quot; suffers 1+D3 Suppression.</characteristic>
              </characteristics>
            </profile>
            <profile name="2 Siren" id="4aa6-419c-4383-7e95" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each attack that targets this unit, the Hit Roll of that attack is worsened by 1.</characteristic>
              </characteristics>
            </profile>
            <profile name="3 Phantasmagoria" id="3574-e8c8-648f-9b09" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an enemy infantry unit within 16&quot; of and visible to this unit. Then, roll 1+D3. The selected unit suffers X Suppression and X SW where X is equal to that roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="4 Blissful Devotion" id="f0ee-54c9-3880-6eda" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a friendly infantry unit within 12&quot; of this unit. This unit and the selected unit may Reposition.</characteristic>
              </characteristics>
            </profile>
            <profile name="5 Symphony of Pain" id="74e4-3a53-1b48-a522" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an enemy unit within 12&quot; of this unit. The selected enemy unit suffers 3+D3 SW. If that enemy unit is within 6&quot;, it suffers 3+2D3 SW instead.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Touch of Slaanesh" id="4300-5871-41b8-b290" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the End step, for each attack made by this unit, a Saving Throw of 6 always fails for that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Disciple of Tzeentch" id="623c-435e-4705-c5b6" hidden="false" import="true" sortIndex="1" type="upgrade">
          <infoLinks>
            <infoLink name="Suppressive (X)" id="e431-5691-a07f-89d3" hidden="false" targetId="aed3-e154-8fa2-5378" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="1 Temporal Surge" id="5269-c330-6472-7c2c" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a friendly unit within 18&quot; of and visible to this unit. Until the end of the battle round, the selected unit&apos;s Move Rolls are improved by 9&quot;.</characteristic>
              </characteristics>
            </profile>
            <profile name="2 Twist Fate" id="d692-3898-67af-f493" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the End step, for each attack this unit makes, a Hit Roll of exactly 1 for that attack is always successful.</characteristic>
              </characteristics>
            </profile>
            <profile name="3 Boon of Mutation" id="0b1a-76fb-5a82-998d" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a single model in a friendly unit within 9&quot; of and visible to this unit. That selected model&apos;s Health is improved by 2 (you may use a Health counter or dice to track it).</characteristic>
              </characteristics>
            </profile>
            <profile name="4 Switch Reality" id="18ed-4cf9-97ca-e204" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a visible friendly unit. Place a marker within 1&quot; of this unit and the selected unit. Then, remove both units from the battlefield and place them into reserves. Then, Deploy both units onto the battlefield wholly within 6&quot; of the other unit&apos;s marker.</characteristic>
              </characteristics>
            </profile>
            <profile name="5 Withering Gaze" id="3727-1908-bcb8-2bf3" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy unit within 16&quot; of and visible to this unit. The selected enemy unit suffers 2D6 Suppression.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Desecration of Worlds" id="6b19-076d-bfe1-d6fa" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select two points along the battlefield edge. Each different enemy unit along the line between those two points suffers 2 SW.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Undivided" id="e351-8cb4-3322-b80b" hidden="false" import="true" sortIndex="4" type="upgrade">
          <infoLinks>
            <infoLink name="Heal/Repair (X)" id="d933-803f-bf5d-6595" hidden="false" targetId="02c8-1ec5-cdab-2572" type="rule"/>
            <infoLink name="Dark Gods’ Hatred" id="d347-6445-4144-97a3" hidden="false" targetId="757c-1e05-d2fb-d633" type="profile"/>
            <infoLink name="Suppressive (X)" id="c097-5116-327d-e2c2" hidden="false" targetId="aed3-e154-8fa2-5378" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="1 Daemonshriek" id="5c07-5228-3000-8a9d" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Each enemy unit within 16&quot; of this unit suffers 1+D3 Suppression. Then, until the next time this unit is Activated or dies, while any enemy unit in the battlefield has Suppressed, this unit gains Dark Gods&apos;Hatred.</characteristic>
              </characteristics>
            </profile>
            <profile name="2 Diabolic Strength" id="8318-1fc6-e13d-a757" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each melee attack this unit makes, reroll a failed Wound Roll for that attack.</characteristic>
              </characteristics>
            </profile>
            <profile name="3 Lay Leach" id="1d9b-1a06-df53-4c8f" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a friendly infantry unit within 16&quot; of this unit. The selected unit Heals 2. If the selected unit is a chaos unit, the unit Heals D3+1 instead.</characteristic>
              </characteristics>
            </profile>
            <profile name="4 Empyric Shield" id="0573-483d-eb35-eadb" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, after a model in this unit is selected to suffer a wound for a ranged attack, roll a D6. On a 5+, the Saving Throw for that wound is always successful.</characteristic>
              </characteristics>
            </profile>
            <profile name="5 Doombolt" id="82a9-2b7a-a07e-47aa" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an enemy unit visible to and within 16&quot; of this unit. The selected enemy unit suffers 2+2D3 SW.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Dark Blessings" id="2116-871b-51e9-895c" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, this unit loses D3+1 Health. Then, each enemy unit within 12&quot; suffers 3D3+X SW where X is the amount of Health this unit lost.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
