      <profiles>
        <profile name="Iron Armoury" id="86ff-0b20-e7be-a2ed" hidden="true" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <comment>Iron Warriors</comment>
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">During list building, for each of your LEGIONARIES units with 4 or more Boltguns and your CHOSEN units, that unit may gain the following ability:</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
