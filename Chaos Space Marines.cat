  <sharedProfiles>
    <profile name="Selfish Ascension" id="298d-635e-7f54-b527" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Each time an enemy unit with Dark Gods&apos;Hatred dies, if the active unit is one of your Chaos Space Marines units, instead of&apos;that unit Heals D3&apos;, you may select one of your units in the battlefield with Selfish Ascension and improve the H of a Leader model in that unit by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Traitorous Contempt" id="3941-84ed-06f0-8bcb" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While any enemy units are within 24” of this unit, those units gain the following ability: Dark Gods’ Hatred: After this unit dies, if the active unit is a Chaos Space Marines unit, that unit Heals D3.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dark Gods’ Hatred" id="757c-1e05-d2fb-d633" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit dies, if the active unit is a Chaos Space Marines unit, that unit Heals D3.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rupture" id="b860-055d-17c3-2fa6" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, select a visible point on the battlefield with 24” and mark it. Each enemy unit within 1” of the centre of that point suffers 3D3 SW.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mutated Invigoration" id="851b-d3b5-a483-5134" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">Select a friendly infantry unit within 12”. The selected unit Heals D3. If that unit has one or more models with Daemonic, it Heals D3+1 instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ancient Fury" id="a975-5d96-4936-cf29" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Explode Roll made for this unit, if that roll was a 3+, this unit gains Enrage (from the monster explode table).</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedSelectionEntries>
    <selectionEntry name="Champion of Chaos" id="d39b-d0f0-66db-fe7f" hidden="false" import="true" type="upgrade">
      <constraints>
