            <characteristic name="A" typeId="13c5-f234-c120-afc3">4</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">1+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">4</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">2</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Shred</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="4664-cd3f-b95b-a458" childName="Black Legion" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="6 Despoil Dominion" id="a3fb-57ec-838a-7c1f" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Black Legion</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After a unit gains this ability, select one of the vaults. While this unit has this unit ability, enemy units within 16&quot; of that vault gain Ruinous Onslaught. After any of your units capture the selected vault, you may&apos;desolate the realm&apos;. If you do, that vault cannot be captured again in this battle. Ability from relics 5 United In Hatred &amp; 6 Despoil Dominion:</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="4664-cd3f-b95b-a458" childName="Black Legion" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="5 United In Hatred" id="7abf-5b82-3deb-e8b7" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Black Legion</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While this unit is not active, each enemy unit visible to it gains Dark Gods&apos;Hatred. If any of those units are within 24&quot; of one or more of your units with Traitorous Contempt, those units gain Ruinous Onslaught.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
