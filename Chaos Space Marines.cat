          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit's Move step, you may change the Tp of each Aslt weapon equipped to this unit's models to CQ until the End step.</characteristic>
          </characteristics>
        </profile>
        <profile name="Point Blank Doctrine" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="658a-6ac5-04fd-7fdf">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack made for a CQ or M L weapon in this unit, that attack gains Critical Hits 5+.</characteristic>
          </characteristics>
        </profile>
