              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Kill Them Slowly" id="1fca-a8e8-d81c-ae59" hidden="true" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <comment>Night Lords</comment>
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any of your infantry units are Activated within 24&quot; of this unit, until the End step, you may have each weapon equipped to models in that unit with Shred lose Shred and gain Suppressive X, where X is equal to that weapon&apos;s D.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="1fa8-6666-7875-be1b" childName="Night Lords" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
