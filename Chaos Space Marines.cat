      <profiles>
        <profile name="Iron Armoury" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="true" id="86ff-0b20-e7be-a2ed">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">During list building, for each of your LEGIONARIES units with 4 or more Boltguns and your CHOSEN units, that unit may gain the following ability:</characteristic>
          </characteristics>
          <comment>Iron Warriors</comment>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="27b0-cf36-cd17-73c6" shared="true" includeChildSelections="true" childName="Iron Warriors" />
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Iron Armoury (Shrapnel Boltguns)" typeId="2dff-53d0-6d25-8c59" typeName="Weapon" hidden="true" id="620b-eaf7-d3c6-26bd">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">Aslt</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">2</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">3+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">2</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">1</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Blast 4</characteristic>
          </characteristics>
          <comment>Iron Warriors</comment>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="27b0-cf36-cd17-73c6" shared="true" includeChildSelections="true" childName="Iron Warriors" />
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Kill Them Slowly" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="true" id="1fca-a8e8-d81c-ae59">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any of your infantry units are Activated within 24" of this unit, until the End step, you may have each weapon equipped to models in that unit with Shred lose Shred and gain Suppressive X, where X is equal to that weapon's D.</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="force" childId="1fa8-6666-7875-be1b" shared="true" includeChildSelections="true" childName="Night Lords" />
              </conditions>
            </modifier>
          </modifiers>
          <comment>Night Lords</comment>
        </profile>
      <profile typeId="dac299e9-caff-4c53-8c7b-76b4cca997e5" typeName="Weapon" hidden="false" id="dcf42e25" name="Missile Launcher"><characteristics><characteristic name="Tp" typeId="7c373bf4-69f5-4b25-96ff-d475afea5e88">Hv</characteristic></characteristics></profile></profiles>
      <infoLinks>
