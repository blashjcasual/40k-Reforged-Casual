        <profile name="4 Lupercal’s Doctrine" id="1ae8-9f26-46dc-09db" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Black Legion</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While this unit is within 12&quot; of an enemy leader unit, for each attack made for this unit, reroll a failed Hit Roll for that attack. After this unit destroys an enemy leader unit, it may Advance.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="4664-cd3f-b95b-a458" childName="Black Legion" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
