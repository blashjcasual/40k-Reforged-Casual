      <profiles>
        <profile name="3 Cloak of Conquests" id="c0cf-c50c-d3f0-523a" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Black Legion</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">This unit gains Resilient 6+. Once, after this unit captures a vault, improve its Resilient X+ by 1. Once, after this unit destroys an enemy unit, improve its Resilient X+ by 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="4664-cd3f-b95b-a458" childName="Black Legion" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="2 Spineshiver Blade" id="de77-e8b2-9508-5523" hidden="true" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <comment>Black Legion</comment>
          <characteristics>
