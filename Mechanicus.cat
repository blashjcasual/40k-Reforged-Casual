    <selectionEntry name="Kastelan Robot" id="e21b-b023-e13b-8301" hidden="false" import="true" sortIndex="4" type="unit">
      <categoryLinks>
        <categoryLink name="Support" id="33be-eac7-ed82-18ab" primary="true" targetId="ccc6-6202-853c-23e4"/>
