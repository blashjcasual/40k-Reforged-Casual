  <sharedProfiles>
    <profile name="Tech-Priest" id="d505-4156-df21-9043" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Once per turn, after any of your units are either Activated or after their Move step, if they are within 8&quot; of one or more units with Tech-Priest, that unit Repairs 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Manufactorum Imperium" id="37fa-7d9c-6c8c-e33c" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">You may add vehicle units to your army list from the documents &quot;40k Reforged: Imperial Guard&quot; and&quot;40k Reforged: Space Marines&quot;. Unit &amp; Weapon Abilities:</characteristic>
      </characteristics>
    </profile>
    <profile name="Invocate Machine" id="f914-73c8-f087-eadf" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s End step, if this was your first turn in a row, you must take another turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Omnissiah’s Blessing" id="2345-8a1c-18ba-8c53" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any of your Adeptus Mechanicus units Repairs, until the End step, for each attack made by that unit, reroll Hit Rolls of 1 for that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Predictive Algorithms" id="88fc-182e-a840-2df9" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 1&quot; of one or more of your other units, for each attack that targets this unit, add 1 to the Saving Throw of that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Soothing Communion" id="c6e9-0484-509a-7b8d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After a friendly vehicle unit within 9” of this unit Heals any amount, if that unit has Suppressed X, worsen the X of Suppressed by that amount.</characteristic>
      </characteristics>
    </profile>
    <profile name="Radioactive" id="7d55-9f74-29f2-c388" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each melee attack that targets this unit, worsen the Wound Roll of that attack by 1. Additionally, while enemy infantry units are within 14&quot; of this unit, those units gain the following ability:</characteristic>
      </characteristics>
    </profile>
    <profile name="Hunter Arachnids" id="5112-c87f-346c-9451" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for this unit, you may reroll that Move Roll.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Radiation" id="89da-6037-0bd7-640b" hidden="false">
      <description>For each attack made for this weapon, if the target unit is an infantry or monster, add 1 to the Wound Roll of that attack.</description>
    </rule>
    <rule name="Arc" id="8120-0b96-92c6-b997" hidden="false">
      <description>For each attack made for this weapon, if the target unit is a vehicle, add 1 to the Wound Roll of that attack.</description>
    </rule>
  </sharedRules>
