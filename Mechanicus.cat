        <constraint id="ac7f-b4c0-1d7b-2564" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <infoLinks>
        <infoLink name="Ignore Cover" id="6af6-acf1-4e8e-2846" hidden="false" targetId="c88b-5cb0-aa9d-b742" type="rule"/>
        <infoLink name="Barrage" id="e109-19c7-f177-f56f" hidden="false" targetId="9cfc-06e3-74c6-ad83" type="rule"/>
        <infoLink name="Resilient (X)" id="c56b-8b5b-40af-ec6f" hidden="false" targetId="253c-c1fa-d29d-d21e" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="1 Shroudpsalm Cover" id="d8e8-9474-0602-d2e0" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each ranged attack targeting this unit from further than 6&quot; from this unit, this unit gains Resilience 5+ for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Omnispex Array" id="535f-dba8-91af-2849" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each ranged attack made for this unit, add 1 to the Hit Roll for that attack. Each ranged weapon in this unit gains Ignore Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Rad Grenade" id="c2e7-bf3f-277a-e0e2" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, you may select an enemy unit within 12&quot; of it. If you do, roll 2D6. The selected enemy unit gains the following ability until the end of the battle round, where X is the result.:</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Autocaduceus" id="70d8-691e-adf5-33cb" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While this unit has Autocaduceus and Tech-Priest, while any friendly units are within 8&quot; of this unit, each time those units would Repair X, they Repair X+1 instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Calculated Casualties" id="a950-644d-3bb8-0a77" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After a unit gains this ability, you may Deploy one of your destroyed units, wholly within your deployment zone with full Health and ready, from among the following:
a) SKITARII RANGERS
b) SKITARII VANGUARDS
c) KATAPHRON BREACHERS
d) KATAPHRON DESTROYERS
This ability can only be used once per battle, even if another unit gains it.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Princeps Voxlink" id="9cf6-dbd1-eeda-f3ce" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit is Activated, select one model in this unit. Until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Princeps Voxlink (Vulcan Mega-Bolter)" id="43b8-eb2f-b4ca-5879" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">Hv</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">6</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">4+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">4</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">2</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Barrage</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
