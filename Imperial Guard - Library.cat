      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="8955-d459-7cf4-2d35" childName="Cadian Platoon Commander" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Cadian Command Centre" id="f92e-f1fc-1487-3654" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is embarked in a transport, that transport gains all of this unit&apos;s abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="0dfa-f5b7-16f7-f527" hidden="false" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit cannot attach to anything.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cadian Regimental Orders" id="fbca-3b91-a35a-916c" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit and your other Imperial Guard infantry units within 24&quot; of this unit, those units gain the following abilities: Hold, On My Command!: After a Move Roll made for this unit during its Move step, you may discard the highest result of that Move Roll. If you do, skip your Attacks step. Then, until the end of the battle round, after each of your Move steps, you may make ranged attacks with this unit. If you do, after the End step, this unit loses this ability. First Rank, Fire! Second Rank, Fire!: For each ranged attack this unit makes, if this is your second turn in a row, a Hit Roll of 6 causes an additional hit. For each of those attacks that target an enemy unit which lost one or more health last turn, add 1 to that Hit Roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Cadian Platoon Commander" id="1233-404b-a5f0-e257" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="fca6-fafd-df07-938d-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
