          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Resolve Test made by a friendly infantry unit within 12&quot; of this unit, reroll a 1 for that Resolve Test.</characteristic>
          </characteristics>
