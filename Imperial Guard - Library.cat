      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="2b15-80d8-b789-c112" childName="Death Korps Combat Engineers" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Surprise Raids" id="a340-7787-ab25-f443" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s End step, if this turn was your first turn in a row, you may take another turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tunnelling" id="8ca8-0b5d-e56c-48c9" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated, you may remove it from the battlefield. If you do, roll 2D6. Then, Deploy this unit anywhere in the battlefield surface area within X inches of any of your other infantry units with Entrench, where X is equal to the result of that roll. Then, you may select one of your infantry units in reserves and Deploy the selected unit wholly within 6&quot; of this unit outside of the engagement range of enemy models.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Explosive Mines" id="fd81-7c45-3b14-4dce" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0ff9-1a20-03eb-7bdb" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
          <infoLinks>
            <infoLink name="Suppressive (X)" id="4696-a086-154c-6aee" hidden="false" targetId="aed3-e154-8fa2-5378" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Explosive Mines" id="037a-c0f8-340e-f9dc" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After an enemy unit finishes an Advance and is within 18” of this unit, you may roll 3D6. If that unit is within X” of this unit where X is equal to the result of that roll, roll a D6 and if that unit finished that Advance within engagement range of any friendly units, add 1 to that roll. On a 5+, that unit suffers 5 Suppression.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Combat Engineers" id="9e76-24dc-3136-184e" defaultSelectionEntryId="e7cc-0bc5-fc81-fbfe" hidden="false">
