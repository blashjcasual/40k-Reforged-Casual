      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="d7fe-2822-e902-74c6" childName="Mordian Platoon Commander" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Modian Command Centre" id="dec8-a3c4-a5ad-e949" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is embarked in a transport, that transport gains all of this unit&apos;s abilities.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mordian Regimental Order" id="bae7-737c-6f61-3bb2" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit and your other Imperial Guard infantry units within 24&quot; of this unit gain the following ability: Form Up!: After any unit is Activated, draw a line parallel to the front edge of your deployment zone between any two points on the battlefield edge. Each unit with Form Up! that line passes through is&apos;forming the line&apos;until the End step. While three or more units are forming the line, for each attack that targets those units, you may reroll failed Saving Throws for that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Mordian Platoon Commander" id="46b0-8393-763f-a935" hidden="false" import="true" type="model">
