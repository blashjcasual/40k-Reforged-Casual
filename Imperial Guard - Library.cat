      <selectionEntries>
        <selectionEntry name="Psychic Powers" id="0f63-86b9-af4b-a710" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3a21-568f-8687-30c0-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="3a21-568f-8687-30c0-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="1 or 2 Telekinesis" id="e1d0-5149-1542-1d8d" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select up to one debris terrain piece within 24” of this unit. Remove the selected debris from the battlefield. Then, place the debris anywhere on the battlefield. Do not place it on any terrain, objectives, or models.</characteristic>
              </characteristics>
            </profile>
            <profile name="3 or 4 Telepathy" id="0b50-440c-774e-6c6d" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select any infantry unit within 16” of this unit. If the selected unit is an enemy unit, it suffers 2D3 Suppression. If the selected unit is a friendly unit with Suppressed X, roll 2D3 and worsen X equal to the result.</characteristic>
              </characteristics>
            </profile>
            <profile name="5 or 6 Divination" id="dcd9-1a32-8930-95d0" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">The next time you roll for initiative, if this unit has an ASTROPATH model, instead of rolling 2D6 roll 6+D6 for that initiative roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Astropath" id="4058-b4d0-bf8d-7848" hidden="false" import="true" type="model">
