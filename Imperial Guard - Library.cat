        <categoryLink name="Leaders" id="d537-72fa-6b00-87a4" primary="true" targetId="2886-2afd-f65f-9d8e"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="10"/>
      </costs>
      <infoLinks>
        <infoLink name="Resilient (X)" id="73d9-0b95-c124-7f60" hidden="false" targetId="253c-c1fa-d29d-d21e" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="Resilient (6+)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="e224-2d43-72ae-3780" childName="Death Korps Platoon Commander" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Death Korps Regimental Orders" id="ab63-5acf-851c-1c9a" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit and your other Astra Militarum infantry units within 24” gain the following abilities: Hold The Line: For each of this unit&apos;s ranged attacks, reroll a Wound Roll of 1 for that attack. Over The Top: For each Move Roll made for this unit, you may reroll that roll. After this unit makes a Move Roll, until the End step, it gains the following ability: Duty To The Emperor: For each melee attack this unit makes, a Wound Roll of 6 for that attack causes an additional wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Look Out Sir!" id="fa28-44cb-adfd-f4d3" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While one or more of your units with Entrench are within 6&quot; of and visible to this unit, for each ranged or SW attack that targets this unit, you may change the Sv of this unit to 2+ for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile id="8bbd-05c9-b245-7367" hidden="false" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit cannot attach to anything.</characteristic>
          </characteristics>
        </profile>
        <profile name="Death Korps Command Centre" id="7205-e4bb-26e1-0bd6" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is embarked in a transport, that transport gains all of this unit&apos;s abilities and loses Look Out Sir!.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Death Korps Platoon Commander" id="4a6a-75cc-64b5-93d3" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="5672-655f-514b-3726-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
