        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Windfall of the Warp - Psychic Awakening" id="bed2-6ef7-19cf-ef16" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
          <characteristics>
            <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, this unit suffers D3 SW, the nearest visible enemy unit with 24” suffers 2D3 SW and this unit gains Psyker 3. Then, this unit may make a Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile id="6cbb-b815-c368-b4c3" hidden="false" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit must attach to:
a) Any Troops unit
This unit may only Cast psychic powers from the ‘Psychic Powers of the Battle Psykers’ table.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Psychic Powers" id="c5ed-adde-d072-fc2e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e78d-a70d-491b-d4e1" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="7bb2-018c-0e9a-caae" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="1 Smite" id="1e8a-57a8-5057-7f3c" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an enemy unit within 8&quot; of and visible to this unit. The selected unit suffers 5+D6 SW.</characteristic>
              </characteristics>
            </profile>
            <profile name="2 Terrifying Visions" id="b578-87d9-1e43-bac8" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy unit within 16&quot; of this unit. The selected unit suffers 3+D6 Suppression.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Gaze of the Emperor" id="4a62-3692-cd00-71d1" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an enemy unit within 16&quot; of and visible to this unit. The selected unit suffers 3+D6 SW.</characteristic>
              </characteristics>
            </profile>
            <profile name="3 Psyker Barrier" id="356b-0645-7e85-e745" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, this unit&apos;s Sv changes to 3+.</characteristic>
              </characteristics>
            </profile>
            <profile name="5 Psychic Maelstrom" id="510a-4c49-8e7b-9411" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select a visible point in the battlefield within 16&quot; of this unit. Then, select up to 4 enemy units within 6&quot; of the selected point. Then, all selected units suffer D3+1 SW.</characteristic>
              </characteristics>
            </profile>
            <profile name="4 Mental Fortitude" id="cf24-13de-5994-9f20" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, this unit&apos;s Rv changes to 4+ and for each SW that targets this unit, the Sv of this unit changes to 4+ for that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
