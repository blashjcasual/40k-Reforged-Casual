              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s End step, if this was your first turn in a row, you must take another turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="Predictive Algorithms" id="0d91-daf1-3c63-ffdf" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 1&quot; of one or more of your other units, for each attack that targets this unit, the Saving Throw of that attack is improved by 1.</characteristic>
              </characteristics>
            </profile>
            <profile name="Soothing Commune" id="eaa0-7f59-1cbc-0585" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
              <characteristics>
