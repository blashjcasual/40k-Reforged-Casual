        <profile name="Chronal Shift" id="9c4d-462e-7d2e-b234" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is in the battlefield, when you roll for initiative, if this unit is within 9&quot; of another with Entwined Will, you may add 1 D6 to that initiative roll.</characteristic>
