      <profiles>
        <profile name="Past Strands" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="0b17-9af3-3c30-0cfe">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any enemy unit's Move step, as a reaction, if that enemy unit is visible to and within 24" of this unit, you may roll a D6. On a 4+, this unit may Reposition and you cannot use this ability again this battle round.</characteristic>
          </characteristics>
