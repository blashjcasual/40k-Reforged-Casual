  <sharedProfiles>
    <profile name="Discs of Tzeentch" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="d0e5-ac01-7a8b-b3d6">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit's Attacks step, it may Reposition.</characteristic>
      </characteristics>
    </profile>
    <profile name="Baleful Arc" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp" hidden="false" id="ccb8-77ea-04d9-04d3">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same results, the nearest visible enemy unit within 9+D6&quot; suffers 6 SW.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cabalistic Rituals" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="3fc0-f99e-3c3d-11d2">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While your active unit is within 18” of this unit, that unit gains the following abilities:

Arcane Endowment: For each Psychic Test this unit makes, add 1 D6 to that Psychic Test.

Ruinous Spellcraft: For each SW an enemy unit suffers, the Saving Throw for that attack is worsened by 1.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
</catalogue>
