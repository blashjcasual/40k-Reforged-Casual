      </constraints>
      <categoryLinks>
        <categoryLink name="Configuration" hidden="false" id="c0fe-5b1b-b5ff-cefe" targetId="9cd6-0442-3f35-6b52" primary="true"/>
      </categoryLinks>
      <profiles>
        <profile name="Entwined Will" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="eb32-15f5-befc-e96e">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is not active, if your active unit with Psyker is within 18" of one or more units with Entwined Will, for each Psychic Test that unit makes, add 1 D6 to that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemonic" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="d87d-c93b-77b5-aedd">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets this unit, the Wound Roll of that attack is always successful on a 5+ and always fails on any result worse than 5+.</characteristic>
          </characteristics>
        </profile>
        <profile name="Inferno" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="106b-f1d2-35eb-d344">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While any of your units with Psyker are within 18" of this unit, for each attack made for this weapon, that attack gains Shred and the Saving Throw for that attack is worsened by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Great Traitors’ Arsenal" id="9e01-7a0b-c633-4761" hidden="false" targetId="cba5-864c-9321-8088" type="profile"/>
      </infoLinks>
    </selectionEntry>
