      <constraints>
        <constraint id="b528-3219-0b8f-35b1" field="selections" includeChildSelections="false" scope="force" shared="true" type="max" value="1"/>
        <constraint id="fa8a-f266-43e2-48fc-min" field="selections" includeChildSelections="false" scope="force" shared="true" type="min" value="1"/>
        <constraint id="fa8a-f266-43e2-48fc-max" field="selections" includeChildSelections="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <infoLinks>
        <infoLink name="Great Traitors’ Arsenal" id="9e01-7a0b-c633-4761" hidden="false" targetId="cba5-864c-9321-8088" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Entwined Will" id="eb32-15f5-befc-e96e" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is not active, if your active unit with Psyker is within 18&quot; of one or more units with Entwined Will, for each Psychic Test that unit makes, add 1 D6 to that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemonic" id="d87d-c93b-77b5-aedd" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets this unit, the Wound Roll of that attack is always successful on a 5+ and always fails on any result worse than 5+.</characteristic>
          </characteristics>
        </profile>
        <profile name="Inferno" id="106b-f1d2-35eb-d344" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While any of your units with Psyker are within 18&quot; of this unit, for each attack made for this weapon, that attack gains Shred and the Saving Throw for that attack is worsened by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
