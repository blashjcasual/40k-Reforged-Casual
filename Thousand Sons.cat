  <sharedProfiles>
    <profile name="Discs of Tzeentch" id="d0e5-ac01-7a8b-b3d6" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Attacks step, it may Reposition.</characteristic>
      </characteristics>
    </profile>
    <profile name="Baleful Arc" id="ccb8-77ea-04d9-04d3" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same results, the nearest visible enemy unit within 9+D6&quot; suffers 6 SW.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cabalistic Rituals" id="3fc0-f99e-3c3d-11d2" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While your active unit is within 18” of this unit, that unit gains the following abilities:

Arcane Endowment: For each Psychic Test this unit makes, add 1 D6 to that Psychic Test.

Ruinous Spellcraft: For each SW an enemy unit suffers, the Saving Throw for that attack is worsened by 1.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Entwined Will" id="5a20-9748-a65b-7e1f" hidden="false">
      <description>While this unit is not active, if your active unit with Psyker is within 18&quot; of one or more units with Entwined Will, for each Psychic Test that unit makes, add 1 D6 to that Psychic Test.</description>
    </rule>
    <rule name="Inferno" id="188a-b70b-b086-9c0e" hidden="false">
      <description>While any of your units with Psyker are within 18&quot; of this unit, for each attack made for this weapon, that attack gains Shred and the Saving Throw for that attack is worsened by 1.</description>
    </rule>
  </sharedRules>
