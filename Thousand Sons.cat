        <profile name="Fickle Grasp" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="1502-5222-acbb-cc01">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit cannot capture objectives or be selected to gain relics.</characteristic>
          </characteristics>
        </profile>
        <profile name="Summoned Horror" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="0dcf-a26f-713a-583d">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit's End step, take another turn. If you have another unit with this ability and ready, you must select that unit to Activate.</characteristic>
