    <selectionEntry type="unit" import="true" name="Grey Knight Brotherhood Champion" hidden="false" id="0e43-60ec-bfcc-c8f1" sortIndex="1">
      <costs>
        <cost name="pts" typeId="points" value="110" />
      </costs>
      <categoryLinks>
        <categoryLink targetId="ccc6-6202-853c-23e4" id="7aa9-c6f5-4157-2e8d" primary="true" name="Support" />
        <categoryLink targetId="205c-3072-067b-d808" id="db48-ba24-b473-3bc0" primary="false" name="Infantry" />
      </categoryLinks>
      <profiles>
        <profile name="Ascetic Bladework" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="54b7-b47f-55fc-34f3">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit makes a Psychic Test, until the End step, the attacks of this unit's melee weapon is improved by X where X depends on which weapon it is:</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Weapon or Force Stave" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="512f-5073-762d-ca1d">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">X is equal to the highest result of that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Falchions" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="5fda-f0e1-cbe6-5b14">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">X is equal to twice the total result of that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Hammer" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="2e3a-bf2e-295b-2458">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">X is equal to the number of 4+ dice results in that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Foremost Protection" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="a2b8-13fc-daeb-8ad2">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">During an Advance or Reposition, this unit may move up to an additional 4" if that move would end within 4" of any enemy units within 24" of one or more friendly leader units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Warp Shunt" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="140d-9357-0e75-030a">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for this unit, add 2 D6 to that roll. Then, until the End step, this unit may move over terrain and enemy units as if they were not there.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Grey Knight Brotherhood Champion" hidden="false" id="2bd2-815a-9694-0999">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2bd2-815a-9694-0999-min" includeChildSelections="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2bd2-815a-9694-0999-max" includeChildSelections="false" />
          </constraints>
          <profiles>
            <profile name="Grey Knight Brotherhood Champion" typeId="a706-96eb-fcae-b696" typeName="Unit" hidden="false" id="3c15-eb42-8582-b5d6">
              <characteristics>
                    <characteristic name="T" typeId="a6ad-d820-8495-f5b0">3</characteristic>
                    <characteristic name="Sv" typeId="9b7f-0dde-683f-6844">3+</characteristic>
                    <characteristic name="H" typeId="18e4-1bf9-a9b8-1e50">5</characteristic>
                    <characteristic name="Rv" typeId="411f-3942-6dc0-7c06">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <entryLinks>
        <entryLink import="true" name="Force Weapon" hidden="false" id="5c56-3fc5-c57a-ccfe" type="selectionEntry" targetId="b35f-4c9c-64a0-4924" />
