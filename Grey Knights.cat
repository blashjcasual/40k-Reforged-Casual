      <profiles>
        <profile name="Ascetic Bladework" id="54b7-b47f-55fc-34f3" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit makes a Psychic Test, until the End step, the attacks of this unit&apos;s melee weapon is improved by X where X depends on which weapon it is:</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Weapon or Force Stave" id="512f-5073-762d-ca1d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">X is equal to the highest result of that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Force Falchions" id="5fda-f0e1-cbe6-5b14" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">X is equal to twice the total result of that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Hammer" id="2e3a-bf2e-295b-2458" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">X is equal to the number of 4+ dice results in that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Foremost Protection" id="a2b8-13fc-daeb-8ad2" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">During an Advance or Reposition, this unit may move up to an additional 4&quot; if that move would end within 4&quot; of any enemy units within 24&quot; of one or more friendly leader units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Warp Shunt" id="140d-9357-0e75-030a" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for this unit, add 2 D6 to that roll. Then, until the End step, this unit may move over terrain and enemy units as if they were not there.</characteristic>
          </characteristics>
        </profile>
      </profiles>
