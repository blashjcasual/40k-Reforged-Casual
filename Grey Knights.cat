        <profile name="Aegis Psyber-Circuit" id="6fc0-3526-8807-8b4d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While one or more other friendly Grey Knights infantry units are within 6&quot; of this unit and this unit is closer or the same distance to an active enemy unit visible to this unit, this unit and those friendly infantry units gain the following ability:</characteristic>
          </characteristics>
        </profile>
        <profile name="Reinforced Wards" id="2410-528a-f54d-a76f" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After a model in this unit is selected to suffer a wound, roll a D6. On a 5+, the Saving Throw for that attack always succeeds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Or for an additional 20 points" id="5cfb-8419-c6c5-d53d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">g) Missile Launcher This model&apos;s right arm is equipped with either: g) Twin Autocannon h) Nemesis Doomfist, and Storm Bolter i) Nemesis Doomfist, and Heavy Flamer j) Nemesis Doomfist, and Incinerator</characteristic>
          </characteristics>
        </profile>
