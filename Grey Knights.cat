        <profile name="Stillness of Spirit" id="2123-848b-beb7-d611" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Psychic Test your units make while within 16&quot; of this unit, you may reroll that Psychic Test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Clarity of Vision" id="c5b1-fbd0-cd7d-8e3d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each D6 you roll for Sanctic Aegis for your units within 16&quot; of this unit, reroll a result of 1 for that roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Brother Captain" id="f7c1-c0c3-125a-71a0" hidden="false" import="true" type="model">
