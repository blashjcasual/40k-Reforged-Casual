</sharedSelectionEntries>
  <sharedRules>
    <rule name="Nemesis" id="24b5-5baa-5c44-0c42" hidden="false">
      <description>For each of this weapon's attacks, if this unit has Psyker, that attack gains Critical Hits 6+. If this unit is within 12" of another friendly Grey Knights unit, that attack gains Critical Hits 5+ instead. If the target unit has Daemonic, that attack gains Critical Hits 6+.</description>
    </rule>
  </sharedRules>
  <selectionEntries>
