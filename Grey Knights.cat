    <selectionEntry name="Relics (Refrence)" id="51ab-3977-5f4d-9601" hidden="false" import="true" sortIndex="-3" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="b477-aa5d-7d52-d3ac" hidden="false" primary="true" targetId="9cd6-0442-3f35-6b52"/>
      </categoryLinks>
      <constraints>
        <constraint id="f89c-5639-4b69-c8aa-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="f89c-5639-4b69-c8aa-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <infoLinks>
        <infoLink name="Nemesis" id="7c3f-7842-ee65-e2a4" hidden="false" targetId="24b5-5baa-5c44-0c42" type="rule"/>
        <infoLink name="Critical Hits X+" id="89fc-d9ea-9547-8ba0" hidden="false" targetId="fff4-3f9d-5d2d-4cf9" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="1 Cuirass of Sacrifice" id="d3ee-6a00-f361-055a" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">This unit gains Resilient 6+. While this unit is within 12&quot; of one or more friendly units, add 1 to Resilient Rolls made for this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Grand Master’s Nemesis Banner" id="b863-7d87-ad5f-bc70" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After you would select targets for this unit, each visible enemy unit within 2D6&quot; suffers 6 SW.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Seal of Forbiddance" id="9b3f-a1cd-4e03-f6e6" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">Each time an enemy unit within 8&quot; of this unit suffers X SW, you may instead have that unit suffer 3 times X Suppression. Additionally, while enemy units with Suppressed are within 4&quot; of this unit, those units cannot be selected for Activation unless their controlling player has no other units available for Activation.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 The Soul Glaive" id="787d-fb9d-d79d-c5a2" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit is Activated, select one model in this unit. Then, until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Augury Malifica" id="8f82-c56a-cbae-d162" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After any enemy unit&apos;s Move step, as a reaction, if that unit is within 24&quot; of and visible to this unit, roll a D6. If that enemy unit was in reserves this turn, add 1 to that roll. On a 5+, make a Psychic Test for this unit. Then, this unit may Cast.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Domina Liber Daemonica" id="6476-7326-8c38-270d" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Attacks step, you may select an enemy unit visible to and within 6&quot; of this unit. The selected enemy unit suffers 3D6+X Suppression where X is this unit&apos;s Psyker X. Then, if the selected enemy unit has Suppressed, that enemy unit must be removed from the battlefield and placed into the reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 The Soul Glaive (Weapon)" id="7fcc-e849-5205-050e" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">ML</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">6+X</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">2+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">3</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">2</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Nemesis X is equal to the total Psyker X from your destroyed units (if you have two destroyed units with Psyker 2, A is equal to 10).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Psychic Powers (Refrence)" id="5d41-be7e-2be6-c477" hidden="false" import="true" sortIndex="-4" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="bfe2-5cc2-843e-1b47" hidden="false" primary="true" targetId="9cd6-0442-3f35-6b52"/>
      </categoryLinks>
      <constraints>
        <constraint id="5ee2-d0d5-a205-928e-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="5ee2-d0d5-a205-928e-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="2 Gate of Infinity" id="b65c-a53e-f4b1-6b4c" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Remove this unit from the battlefield and place it into reserves. Then, choose either&apos;warp puncture&apos;or&apos;vanguard beacon&apos;. If you chose warp puncture, Deploy this unit anywhere in the battlefield at least 3D6&quot; away from all enemy units. If you chose vanguard beacon, Deploy this unit wholly within D6+2&quot; of any of your units with Resolute Communion.</characteristic>
          </characteristics>
        </profile>
        <profile name="1 Summon" id="198f-050e-6ca5-106c" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one of your other friendly Grey Knights units in the battlefield or in reserves. If the selected unit is in the battlefield, remove that unit from the battlefield and place it into reserves. Then, Deploy the selected unit wholly within 6&quot; of this unit, outside of engagement range of enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Hallow Ground" id="a156-ce34-fc8a-57a4" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each melee attack an enemy unit makes targeting this unit, this unit gains Resilient 5+ for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Shrouding" id="0eec-f502-7dbe-33e8" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each ranged attack that targets this unit, add 1 to the D6 roll of Sanctic Aegis for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Purifying Flame" id="67d9-410a-24c8-4403" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select one enemy unit visible to and within 8&quot; of this unit or within 8&quot; of one or more of your units with Resolute Communion. Then, the selected unit suffers D3+X SW where X is equal to this unit&apos;s current Health.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Argent Psyblast" id="e1a5-f603-48b1-5aab" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one weapon with Nemesis in this unit. Once during this turn, after a successful wound roll for the selected weapon, the target of that attack suffers 6 SW.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
