      <categoryLinks>
        <categoryLink name="Configuration" hidden="false" id="c104-4da2-ecbd-9b3f" targetId="9cd6-0442-3f35-6b52" primary="true" />
      </categoryLinks>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="baf9-9a3f-393b-abb5-min" includeChildSelections="false" />
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="baf9-9a3f-393b-abb5-max" includeChildSelections="false" />
      </constraints>
      <infoLinks>
        <infoLink name="Sanctic Aegis" id="3a8b-aad5-6a47-3c36" hidden="false" type="profile" targetId="141f-c84e-6982-ba56" />
        <infoLink name="We Are The Hammer" id="7f7b-3376-44ab-eca1" hidden="false" type="profile" targetId="3bfb-8d5a-08a7-a5ca" />
        <infoLink name="Warp Drives of Titan" id="18bf-32af-393c-adbf" hidden="false" type="profile" targetId="7b20-82b2-f21f-4345" />
        <infoLink name="Psychic Resonance" id="e9bd-c7e9-c442-746a" hidden="false" type="profile" targetId="e371-a49c-1740-3005" />
        <infoLink name="Cleansing Psalm" id="c87f-e7ad-f627-c1c1" hidden="false" type="profile" targetId="4b90-458f-5908-3282" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Relics (Refrence)" hidden="false" id="51ab-3977-5f4d-9601" sortIndex="-3">
      <profiles>
        <profile name="1 Cuirass of Sacrifice" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="d3ee-6a00-f361-055a">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">This unit gains Resilient 6+. While this unit is within 12" of one or more friendly units, add 1 to Resilient Rolls made for this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Grand Master’s Nemesis Banner" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="b863-7d87-ad5f-bc70">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After you would select targets for this unit, each visible enemy unit within 2D6" suffers 6 SW.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Seal of Forbiddance" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="9b3f-a1cd-4e03-f6e6">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">Each time an enemy unit within 8" of this unit suffers X SW, you may instead have that unit suffer 3 times X Suppression. Additionally, while enemy units with Suppressed are within 4" of this unit, those units cannot be selected for Activation unless their controlling player has no other units available for Activation.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 The Soul Glaive" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="787d-fb9d-d79d-c5a2">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit is Activated, select one model in this unit. Then, until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Augury Malifica" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="8f82-c56a-cbae-d162">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After any enemy unit's Move step, as a reaction, if that unit is within 24" of and visible to this unit, roll a D6. If that enemy unit was in reserves this turn, add 1 to that roll. On a 5+, make a Psychic Test for this unit. Then, this unit may Cast.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Domina Liber Daemonica" typeId="9b56-9768-f88b-14ac" typeName="Relics" hidden="false" id="6476-7326-8c38-270d">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit's Attacks step, you may select an enemy unit visible to and within 6" of this unit. The selected enemy unit suffers 3D6+X Suppression where X is this unit's Psyker X. Then, if the selected enemy unit has Suppressed, that enemy unit must be removed from the battlefield and placed into the reserves.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 The Soul Glaive (Weapon)" typeId="2dff-53d0-6d25-8c59" typeName="Weapon" hidden="false" id="7fcc-e849-5205-050e">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">ML</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">6+X</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">2+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">3</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">2</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Nemesis X is equal to the total Psyker X from your destroyed units (if you have two destroyed units with Psyker 2, A is equal to 10).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f89c-5639-4b69-c8aa-min" includeChildSelections="false" />
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f89c-5639-4b69-c8aa-max" includeChildSelections="false" />
      </constraints>
      <categoryLinks>
        <categoryLink name="Configuration" hidden="false" id="b477-aa5d-7d52-d3ac" targetId="9cd6-0442-3f35-6b52" primary="true" />
      </categoryLinks>
      <infoLinks>
        <infoLink name="Nemesis" id="7c3f-7842-ee65-e2a4" hidden="false" type="rule" targetId="24b5-5baa-5c44-0c42" />
        <infoLink name="Critical Hits X+" id="89fc-d9ea-9547-8ba0" hidden="false" type="rule" targetId="fff4-3f9d-5d2d-4cf9" />
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Psychic Powers (Refrence)" hidden="false" id="5d41-be7e-2be6-c477" sortIndex="-4">
      <profiles>
        <profile name="2 Gate of Infinity" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="b65c-a53e-f4b1-6b4c">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Remove this unit from the battlefield and place it into reserves. Then, choose either'warp puncture'or'vanguard beacon'. If you chose warp puncture, Deploy this unit anywhere in the battlefield at least 3D6" away from all enemy units. If you chose vanguard beacon, Deploy this unit wholly within D6+2" of any of your units with Resolute Communion.</characteristic>
          </characteristics>
        </profile>
        <profile name="1 Summon" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="198f-050e-6ca5-106c">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one of your other friendly Grey Knights units in the battlefield or in reserves. If the selected unit is in the battlefield, remove that unit from the battlefield and place it into reserves. Then, Deploy the selected unit wholly within 6" of this unit, outside of engagement range of enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Hallow Ground" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="a156-ce34-fc8a-57a4">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each melee attack an enemy unit makes targeting this unit, this unit gains Resilient 5+ for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Shrouding" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="0eec-f502-7dbe-33e8">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, for each ranged attack that targets this unit, add 1 to the D6 roll of Sanctic Aegis for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Purifying Flame" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="67d9-410a-24c8-4403">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select one enemy unit visible to and within 8" of this unit or within 8" of one or more of your units with Resolute Communion. Then, the selected unit suffers D3+X SW where X is equal to this unit's current Health.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Argent Psyblast" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power" hidden="false" id="e1a5-f603-48b1-5aab">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one weapon with Nemesis in this unit. Once during this turn, after a successful wound roll for the selected weapon, the target of that attack suffers 6 SW.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink name="Configuration" hidden="false" id="bfe2-5cc2-843e-1b47" targetId="9cd6-0442-3f35-6b52" primary="true" />
      </categoryLinks>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5ee2-d0d5-a205-928e-min" includeChildSelections="false" />
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5ee2-d0d5-a205-928e-max" includeChildSelections="false" />
      </constraints>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Grand Master" hidden="false" id="104a-d6af-9b28-1f1d" sortIndex="1">
      <categoryLinks>
        <categoryLink name="Leaders" hidden="false" id="9abe-f1b3-9268-a427" targetId="2886-2afd-f65f-9d8e" primary="true" />
        <categoryLink name="Infantry" hidden="false" id="bc28-a2c0-bf53-422a" targetId="205c-3072-067b-d808" primary="false" />
      </categoryLinks>
      <profiles>
        <profile name="Leader" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader" hidden="false" id="95ba-06f2-9f46-35c9">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit must attach to either:
a) GREY KNIGHT TERMINATORS
b) GREY KNIGHT PALADIN</characteristic>
          </characteristics>
        </profile>
        <profile name="Guiding Will" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="7881-5168-1aff-245b">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While selecting a target for ranged attacks or psychic powers for any of your Grey Knights units, enemy units within engagement range of this unit may be selected from an additional 4" away.</characteristic>
