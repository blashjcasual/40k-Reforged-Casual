    <selectionEntry type="unit" import="true" name="Grey Knight Dreadnought" hidden="false" id="afe9-1819-c6b0-ae29" sortIndex="1">
      <costs>
        <cost name="pts" typeId="points" value="160" />
      </costs>
      <categoryLinks>
        <categoryLink targetId="ccc6-6202-853c-23e4" id="2918-62b0-b261-c231" primary="true" name="Support" />
        <categoryLink targetId="b239-6bd1-e7a0-0a02" id="8fed-4bf3-daab-2e22" primary="false" name="Vehicle" />
      </categoryLinks>
      <profiles>
        <profile name="Aegis Psyber-Circuit" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="6fc0-3526-8807-8b4d">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While one or more other friendly Grey Knights infantry units are within 6" of this unit and this unit is closer or the same distance to an active enemy unit visible to this unit, this unit and those friendly infantry units gain the following ability:</characteristic>
          </characteristics>
        </profile>
        <profile name="Reinforced Wards" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="2410-528a-f54d-a76f">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After a model in this unit is selected to suffer a wound, roll a D6. On a 5+, the Saving Throw for that attack always succeeds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Or for an additional 20 points" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="5cfb-8419-c6c5-d53d">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">g) Missile Launcher This model's right arm is equipped with either: g) Twin Autocannon h) Nemesis Doomfist, and Storm Bolter i) Nemesis Doomfist, and Heavy Flamer j) Nemesis Doomfist, and Incinerator</characteristic>
          </characteristics>
        </profile>
        <profile name="Venerable" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="83f6-574b-45d5-6d93">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit's Health is improved by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
