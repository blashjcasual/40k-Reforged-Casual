  <sharedProfiles>
    <profile name="Sanctic Aegis" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="141f-c84e-6982-ba56">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After a model in any of your Grey Knights units is selected to suffer a wound, roll a D6. On a 6+, the Saving Throw for that attack always succeeds. If that unit is within 12" of another friendly Grey Knights unit, add 1 to that roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Psychic Resonance" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="e371-a49c-1740-3005">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Your Grey Knights units with Psyker X gain the following ability:


Windfall of the Warp, Cleansing Psalm: After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, select up to one friendly infantry or monster unit within 8” of this unit with a model with fewer Health that it started with. Then, the selected unit Heals 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="We Are The Hammer" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="3bfb-8d5a-08a7-a5ca">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Reroll failed Resolve Tests made for your Grey Knights units. Unit &amp; Weapon Abilities:</characteristic>
      </characteristics>
    </profile>
    <profile name="Cleansing Psalm" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp" hidden="false" id="4b90-458f-5908-3282">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, select up to one friendly infantry or monster unit within 8” of this unit with a model with fewer Health that it started with. Then, the selected unit Heals 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Resolute Communion" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="ca9b-954c-18a6-ad4f">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit and another of your active units is in the battlefield, while selecting a unit for Windfall of the Warp, Cleansing Psalm, you may instead select up to one friendly infantry or monster unit within 8" of this unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warp Drives of Titan" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="7b20-82b2-f21f-4345">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any of your units Activate in reserves, you may use'warp drives'. If you do, roll 12+2D6. Then, you must Deploy that unit anywhere in the battlefield at least X" away from all enemy units and the enemy unit deployment zone where X is the result of that roll. Then, that unit cannot Advance or Reposition this turn.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
