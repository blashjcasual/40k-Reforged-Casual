            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While selecting a target for ranged attacks or psychic powers for any of your Grey Knights units, enemy units within engagement range of this unit may be selected from an additional 4&quot; away.</characteristic>
          </characteristics>
        </profile>
        <profile name="Terrifying Perfection" id="2aa8-3d57-5bb8-2efa" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack your units make which target an enemy unit within 24&quot; of this unit, reroll a Hit Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
