        <profile name="Patient Trackers" id="6717-c5b2-c4ea-8446" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated in reserves, you may select an enemy unit in the battlefield. For the rest of the battle, that unit gains the following ability and other enemy units lose it:</characteristic>
          </characteristics>
        </profile>
        <profile name="Lone Pack" id="b8f0-ca12-a252-907b" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit has Tactical Doctrine and there are no other friendly units within 12&quot; of this unit, for each attack this unit makes that targets an enemy unit with Tracked, add 1 to the Hit Roll of that attack.</characteristic>
          </characteristics>
        </profile>
        <profile id="52a4-eb43-f700-4c04" hidden="false" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit may be attached by:
a) PHOBOS CAPTAIN
b) PHOBOS LIBRARIAN
c) PHOBOS LIEUTENANT</characteristic>
          </characteristics>
        </profile>
      </profiles>
