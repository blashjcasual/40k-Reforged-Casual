  <sharedProfiles>
    <profile name="Chapter Captain" id="3a69-b9b8-2f45-4cd1" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit gains the Captain ability from your selected chapter’s section.</characteristic>
      </characteristics>
    </profile>
    <profile name="Astartes Battleline" id="0181-7b67-dc1a-9ea1" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After you roll for initiative or Activate a leader unit, select one of the following ‘doctrine’ abilities for all of your units with Astartes Battleline:

Tactical Doctrine: You may reroll Move Rolls made for this unit.

Assault Doctrine: For each attack this unit makes that targets an enemy unit within 12” of this unit, add 1 to the Hit Roll of that attack.

Devastator Doctrine: For each attack this unit makes that targets an enemy unit further than 12” away from this unit, add 1 to the Hit Roll of that attack.

All of your units with Astartes Battleline gain that ability until the next time you select a doctrine ability. 

While your infantry units are within 16” of this unit, they gain the doctrine ability this unit has.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lightning Arc" id="9eaa-a8db-8a38-b2e5" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, select up to 2 different visible enemy units within 6+3D6” of this unit. Each selected unit suffers 3 SW.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tactical Insight" id="8644-71e5-a9e7-7d14" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Once per battle round, after this unit&apos;s Select step, if the centre point of one or more objectives is visible to this unit, you may&apos;assess the battlefield&apos;. If you do, this unit becomes ready. Then, skip to the End step.</characteristic>
      </characteristics>
    </profile>
    <profile name="Litany of Hate" id="35c4-0160-49a8-530f" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack made for a friendly unit within 12&quot; of this unit which targets an enemy unit within 12&quot;, if that attack&apos;s S is equal to or greater than the target&apos;s T, add 1 to the Wound Roll for that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Support Element" id="731d-62c8-ab31-eed7" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s End step, if this was your first turn in a row, take another turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Black Rage" id="8901-8664-944c-a6e7" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated, the closest visible enemy unit gains the following ability until the End step. If two or more units are the closest enemy unit, you choose which one of those units gains it until the End step.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ancient’s Wisdom" id="fcd8-890d-39ef-1312" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Resolve Test made for your units within 12&quot; of this unit, reroll a result of 1 for that Resolve Test.</characteristic>
      </characteristics>
    </profile>
    <profile name="Great Traitors’ Arsenal" id="cba5-864c-9321-8088" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">You may add units to your Army List from the “Chaos Space Marine Arsenal” document.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Vivispectrum" id="f7fd-cebe-ccc9-0bc5" hidden="false">
      <description>For each attack made by this unit, a Wound Roll of 6 causes and additional wound.</description>
    </rule>
    <rule name="Windfall of the Warp, Lightning Arc" id="3191-a1e1-1f37-0cdd" hidden="false">
      <description>After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, select up to 2 different visible enemy units within 6+3D6&quot; of this unit. Each selected unit suffers 3 SW.</description>
    </rule>
    <rule name="On My Command" id="70e2-66ec-acb2-18d4" hidden="false">
      <description>While enemy units are visible to this unit, for each attack made by your units that targets those units, add 1 to the Hit Roll of that attack. Attacks can only be affected by an ability with this name once.</description>
    </rule>
    <rule name="Litany of Hate" id="6f33-c1c9-bda5-9cce" hidden="false">
      <description>For each attack made for a friendly unit within 12&quot; of this unit which targets an enemy unit within 12&quot;, if that attack&apos;s S is equal to or greater than the target&apos;s T, add 1 to the Wound Roll for that attack.</description>
    </rule>
    <rule name="Deliberate Tactician" id="5ef9-b670-dd95-d45f" hidden="false">
      <description>For each attack made by this unit, reroll a Hit Roll of 1 of that attack.</description>
    </rule>
    <rule name="The Time For Silence Is Over" id="9848-3a4b-2b35-ec70" hidden="false">
      <description>After this unit is Activated, until the End step, each enemy unit that not visible to this unit gains the following ability:


Unnerved: While an enemy REIVERS unit is within 6” of this unit, its Rv is worsened by 1.


Combat Grapnels: While this unit’s models move, they may ignore vertical distances.</description>
    </rule>
    <rule name="Land Raider" id="11da-4193-aebb-67fa" hidden="false">
      <comment>for centurions</comment>
      <description>This unit may embark into any ‘LAND RAIDER’ unit.</description>
    </rule>
  </sharedRules>
