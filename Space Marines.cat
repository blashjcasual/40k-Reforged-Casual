      <profiles>
        <profile name="Signum Targeting" id="557e-79ab-f03c-20d5" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets a visible enemy unit, reroll Hit Rolls of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Direct Fire Barrage" id="90f2-00ab-5ff3-9877" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit selects targets for all its weapons, if all of those attacks are targeting the same unit and this unit has Devastator Doctrine and there are no enemy units within 8&quot; of this unit, roll 2D6. Then select all other enemy units within X&quot; of the selected target, where X is equal to that roll. Also make attacks for all of this units weapons targeting each of the selected units (ignoring normal targeting restrictions).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Desolation Marines" id="5e0e-25a2-13e9-305e" defaultSelectionEntryId="0343-d4dd-89e2-194a" hidden="false">
