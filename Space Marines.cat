        <profile name="6 Promethean Fire" id="e61a-2379-2bab-24cf" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Salamanders</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While your active unit is within 12&quot; of this unit, for each attack made for a weapon with&apos;flame&apos;,&apos;melta&apos;, or&apos;pyre&apos;in the name in that unit, that attack gains Critical Hits 5+.</characteristic>
          </characteristics>
