        </profile>
        <profile name="Unyielding Bulwark" id="e466-9233-31ed-9f9a" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 12&quot; of a friendly leader unit, for each D6 you roll for this unit&apos;s Ultima Storm Shield&apos;s Shield ability, add 1 to that roll.</characteristic>
