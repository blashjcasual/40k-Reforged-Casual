              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="5 Igneous Plate" id="8c23-e0c3-875a-acb1" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Salamanders</comment>
