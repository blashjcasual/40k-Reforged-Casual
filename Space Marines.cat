        <profile name="Firestorm" id="4860-b540-2566-5d55" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit finishes Advance, if that move ended at least 10&quot; away from where it started, this unit&apos;s&apos;Assault Cannons&apos;or&apos;Flamestorm Cannon&apos;gains Shred until the End step.</characteristic>
          </characteristics>
        </profile>
        <profile name="Baalite Engine" id="a9fa-9f45-d3e7-0ddb" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While a friendly unit within 12&quot; of this unit has Assault Doctrine, for each Move Roll made for this unit, the minimum result of those dice is 3.</characteristic>
          </characteristics>
        </profile>
