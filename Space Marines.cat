        <profile name="3 The Wulfen Stone" id="379d-7c0c-60f4-1088" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit Activates, you may ‘release the raging spirit’. If you do, this unit gains the following ability until the next time this unit Activates: Raging Spirit:


● You may reroll Move Rolls made for this unit.
● For each melee attack this unit makes, a Hit Roll of 6 causes an additional hit.
● This unit cannot capture objectives.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="6e28-72e3-f8fe-a6d3" childName="Space Wolves" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="6 Gjallarhorn of the Alfather" id="0743-7019-205b-3db1" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit Activates, select up to one of your ready units within 8&quot; of this unit. Each model in this unit and the selected unit gains the weapon below until the End step of the next turn. Then, if you selected another unit, after this turn&apos;s End step, take another turn, and you must select that unit to Activate that turn.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="6e28-72e3-f8fe-a6d3" childName="Space Wolves" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="1 Gilded Boltgun" id="7692-4745-3fd9-3a6c" hidden="true" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <comment>Ultramarines</comment>
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">Aslt</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">12</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">3+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">3</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">1</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Blast 2</characteristic>
