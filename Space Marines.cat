      <profiles>
        <profile name="Promethium Purge" id="6722-eb63-20fe-4474" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit has Assault Doctrine, after you select an enemy unit within 12&quot; of this unit as the target for a Pyreblaster in this unit, that weapon gains 1 Attack until the End step.</characteristic>
