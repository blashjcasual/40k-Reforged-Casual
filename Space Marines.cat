      <profiles>
        <profile name="Infiltrate Enemy Lines" id="a7b5-2537-517b-651b" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated in reserves, you may&apos;infiltrate&apos;. If you do, roll 2D6+1. Then, Deploy this unit anywhere in the battlefield at least X&quot; away from all enemy units where X is the result of that roll and during this turn&apos;s Move step, do not make a Move Roll and this unit cannot Advance or Reposition.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scout Ahead" id="e61a-6b83-12ba-0131" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is visible to one or more units with Astartes Battleline, this unit gains that unit&apos;s doctrine ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hostile Territory" id="59aa-a436-6c95-4f13" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Attacks step, this unit may Reposition up to XD3&quot; where X is equal to the number of different enemy units within 12&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
