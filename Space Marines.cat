      <profiles>
        <profile name="1 Precognition" id="e071-7e77-1f5e-dea5" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Ultramarines</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated, for each ranged attack that targets this unit, the Hit Roll of that attack is worsened by 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="22ae-1fb4-b388-d475" childName="Ultramarines" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="1 The Gate" id="27ae-c5a0-1e34-bbc3" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Remove this unit from the battlefield and place it into reserves. Then, Deploy it anywhere in the battlefield at least 3D6&quot; away from enemy models.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="6e28-72e3-f8fe-a6d3" childName="Space Wolves" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="1 Fire Shield" id="43f3-8efc-69dc-b94e" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Salamanders</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, after a model in this unit is selected to suffer a wound for a ranged attack, roll a D6. On 5+, the Saving Throw for that wound always succeeds.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="39a2-a31c-bc16-9208" childName="Salamanders" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="1 Transfixing Gaze" id="fe3a-b4d0-c13a-7c55" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Blood Angels</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy unit within 16&quot; of and visible to this unit. The selected enemy unit suffers 3D3 Suppression.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="e9e1-2a24-faf7-e76f" childName="Blood Angels" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="2 Telepathic Assault" id="6e8e-b21b-b2ab-7aa6" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Ultramarines</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an enemy unit within 16&quot; of and visible to this unit. Roll 2D3. Then, the selected unit suffers X Suppression and X SW where X is equal to that roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="22ae-1fb4-b388-d475" childName="Ultramarines" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="3 Psychic Shackles" id="7687-a75c-55f6-9276" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Ultramarines</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an infantry or monster unit within 16&quot; of and visible to this unit. The selected unit suffers D6+3 Suppression.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="22ae-1fb4-b388-d475" childName="Ultramarines" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="4 Scryer&apos;s Gaze" id="47f1-88d0-696f-3be3" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Ultramarines</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">The next time you roll for initiative, roll an additional D6 for that roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="22ae-1fb4-b388-d475" childName="Ultramarines" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="5 Electrodisplacement" id="1444-42a1-692f-8ddb" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Ultramarines</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a friendly unit visible to this unit and select a point anywhere in the battlefield within 1&quot; of that unit and mark that point. Remove the selected unit from the battlefield, place it into reserves. Then, Deploy that unit wholly within 6&quot; of this unit outside of engagement range of enemy models. Then, remove this unit from the battlefield, place it into reserves and then, Deploy it wholly within 6&quot; of the mark.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="22ae-1fb4-b388-d475" childName="Ultramarines" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="6 Storm of the Emperor&apos;s Wrath" id="5066-45c8-4816-6fdc" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Ultramarines</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an enemy unit within 16&quot; of and visible to this unit. That unit suffers D3+2 SW and each of those SW has 2 Damage instead of 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="22ae-1fb4-b388-d475" childName="Ultramarines" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="2 Murderous Hurricane" id="f638-8c71-a6d7-95e3" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit Activates or dies, while enemy units are within 16” of this unit, those units gain the following ability:


Icy Chill: For each Move Roll made for this unit, discard the highest result of that roll. Then, this unit suffers X Suppression where X is equal to that discarded dice result.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="6e28-72e3-f8fe-a6d3" childName="Space Wolves" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="3 Thunderclap" id="896f-8425-5396-8034" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, roll 2+D3. Then, each enemy unit within 12&quot; of and visible to this unit suffers X SW and X Suppression where X is equal to that roll.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="6e28-72e3-f8fe-a6d3" childName="Space Wolves" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="5 Storm Caller" id="4cad-4c5a-b536-b8c1" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit Activates, for each ranged attack that targets this unit, the Hit Roll of that attack is worsened by 1.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="6e28-72e3-f8fe-a6d3" childName="Space Wolves" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="6 Fury of the Wolf Spirits" id="f7f9-7461-520d-683e" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one model in this unit. Until the End step, the selected model gains the following weapons:</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="6e28-72e3-f8fe-a6d3" childName="Space Wolves" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="4 Living Lighting" id="9d17-6055-cc4c-1edd" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy unit within 12” of and visible to this unit. Then select another enemy unit within 12” of and visible to the first unit. Each selected unit suffers 2+D3 SW.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="6e28-72e3-f8fe-a6d3" childName="Space Wolves" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="2 Draconic Aspect" id="956c-4753-39cc-1441" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Salamanders</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">All enemy units within 12&quot; of and visible to this unit suffers 2+D3 Suppression.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="39a2-a31c-bc16-9208" childName="Salamanders" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="3 Burning Hands" id="7055-c2eb-8ead-15ad" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Salamanders</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one model in this unit. Until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="39a2-a31c-bc16-9208" childName="Salamanders" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="4 Fury of Nocturne" id="2ce7-26d1-e832-7ade" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Salamanders</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a point in the battlefield within 12&quot; of and visible to this unit. All enemy units within 3D3 of that point suffer 3 SW.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="39a2-a31c-bc16-9208" childName="Salamanders" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="5 Vulkan’s Anvil" id="0e16-c450-6d1a-1385" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Salamanders</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated, it gains Resilient 5+, and for each attack with Ignore Cover that targets this unit, add 1 to Resilient Rolls for that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="39a2-a31c-bc16-9208" childName="Salamanders" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="6 Nocturne’s Fire" id="882b-ae1b-9828-d4c2" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Salamanders</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, all enemy units within 3D6&quot; suffer 2 SW. Then, all enemy units within 8&quot; of this unit suffer an additional 2 SW.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="39a2-a31c-bc16-9208" childName="Salamanders" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="2 Blood Boil" id="c97b-5a1d-c215-5159" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Blood Angels</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select an enemy infantry or monster unit within 16&quot; of and visible to this unit. The selected unit suffers 3D3 SW.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="e9e1-2a24-faf7-e76f" childName="Blood Angels" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="5 The Blood Lance" id="7777-0861-b31a-d66c" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Blood Angels</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select a point anywhere in the battlefield visible to and up to 24&quot; away from this unit. Then, draw a line along the battlefield between that point and this unit. All enemy units along that line suffer D3+1 SW.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="e9e1-2a24-faf7-e76f" childName="Blood Angels" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="6 Unleash Rage" id="58b2-d381-bf0b-68e1" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Blood Angels</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, f or each melee attack made for this unit, that attack gains Critical Wounds 6+.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="e9e1-2a24-faf7-e76f" childName="Blood Angels" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="4 Shield of Sanguinius" id="9bbe-e4ac-f845-6a54" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Blood Angels</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, after a wound is assigned to a model in this unit, roll a D6. On a 5+, the Saving Throw for that wound always succeeds.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="e9e1-2a24-faf7-e76f" childName="Blood Angels" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="3 Quickening" id="f4df-67ba-577c-459a" hidden="true" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <comment>Blood Angels</comment>
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a friendly infantry unit within 6&quot; of this unit. The selected unit may Reposition.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="e9e1-2a24-faf7-e76f" childName="Blood Angels" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
