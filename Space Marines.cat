      <profiles>
        <profile name="Blood Chalice" id="1dc6-0b83-d2b4-e832" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Move step, you may select up to two friendly infantry units within 4&quot; of this unit. If you do, the selected units each Heal 1, and if any of those units had Succumbed, they lose that ability and Heal an additional 1. Then, skip the Attacks step this turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Support Element" id="b71f-8fe1-a911-3552" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s End step, if this was your first turn in a row, take another turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
