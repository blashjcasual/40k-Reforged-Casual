        <profile name="Forgemaster’s Relic: 4 Hide of the Drakelords" id="ad97-9127-bed0-c8e6" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each wound a model in this unit suffers, roll a D6. On a 5+, that attack fails, and, after the current step, the unit that made that attack suffers SW equal to that attack’s D.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="39a2-a31c-bc16-9208" childName="Salamanders" field="selections" includeChildSelections="true" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
        <profile name="Forgemaster’s Relic: 5 Magmatic Mantle" id="10db-368f-168c-f6b6" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">This unit gains Resilient 5+. After this unit&apos;s Attacks step, each enemy unit within 3D6” suffers 2 SW. If those units are within 6” they suffer an additional 2 SW.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
