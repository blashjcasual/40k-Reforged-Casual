        <profile name="1 The Helm of Durfast" id="82cc-1882-607b-d958" hidden="true" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <comment>Space Wolves</comment>
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After an enemy unit&apos;s Move step, as a reaction, if that enemy unit is within 24&quot; of and visible to this unit, you may roll a D6. On a 5+, this unit may Reposition.</characteristic>
          </characteristics>
