      <profiles>
        <profile name="Infiltrate Enemy Lines" id="35b4-8faa-8e85-9e37" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated in reserves, you may&apos;infiltrate&apos;. If you do, roll 2D6+1. Then, Deploy this unit anywhere in the battlefield at least X&quot; away from all enemy units where X is the result of that roll and during this turn&apos;s Move step, do not make a Move Roll and this unit cannot Advance or Reposition.</characteristic>
          </characteristics>
        </profile>
        <profile name="Omni-Scramblers" id="e453-66da-a3bc-673d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After an enemy unit Activates within 12&quot; of this unit, you may roll a D6. On a 5+, that unit becomes ready and must skip the Move and Attacks steps.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Infiltrators" id="842f-2e3a-900e-ffb7" defaultSelectionEntryId="3b0a-ec42-e27a-942c" hidden="false">
