      <profiles>
        <profile name="Know The Enemy" id="0063-0e87-3d4e-b224" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After an enemy infantry unit dies within 12&quot; of this unit, you may&apos;use the vivispectrum&apos;. If you do, for the rest of the battle, for each attack made for this unit that targets an infantry unit, reroll a Wound Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Biologis Knowledge" id="25c1-90b8-bdd0-ddb7" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack made for this unit that targets an infantry unit, a Hit Roll of 6+ for that attack causes that attack to always wound.</characteristic>
          </characteristics>
        </profile>
        <profile id="203c-7860-d210-ff13" hidden="false" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit must attach to either:
a) HEAVY INTERCESSORS
b) MELTA ERADICATORS
c) HEAVY BOLTER ERADICATORS
d) AGGRESSORS</characteristic>
          </characteristics>
        </profile>
      </profiles>
