      <profiles>
        <profile name="Holo-Fields" id="f2ca-d9c3-0db2-ff85" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After a model in this unit is selected to suffer a wound, if the unit which made that attack is further than 12&quot; away, roll a D6. On a 5+, the Saving Throw for that wound always succeeds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Eternal Duty" id="f32a-3950-b7e1-0a1f" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack made by this unit that targets a unit with Fatal Thread, add 1 to the Hit Roll of that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Ghostlight" id="c61c-3923-67ae-4570" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="209d-f45c-f2ed-73de-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="209d-f45c-f2ed-73de-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
