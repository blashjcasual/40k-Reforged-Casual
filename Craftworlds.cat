      <profiles>
        <profile name="Dissipate Energy Field" id="7f3b-f837-4083-6afa" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Once per battle, after any enemy unit&apos;s Move step, as a reaction, you may&apos;dissipate the energy field&apos;. If you do, this unit&apos;s Sv changes to 4+. Then, each enemy unit within 12&quot; of and visible to this unit suffers D3+1 Suppression.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wraithbone" id="a66c-bd9d-5f4e-622e" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each SW from a psychic power this unit suffers, this unit gains Resilient 5+ for that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
