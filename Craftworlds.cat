      <constraints>
        <constraint id="6ea7-4439-5ad4-86a1" field="selections" includeChildSelections="false" scope="force" shared="true" type="max" value="1"/>
        <constraint id="6c30-cb33-e760-fa66-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="6c30-cb33-e760-fa66-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="1 Blood Moon of Khaine" id="6be5-4d96-d9ca-1370" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each ranged attack made for this unit, that attack gains Critical Wound 5+. If the target unit of those attacks has Fatal Thread, reroll a Wound Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Webway Loom" id="4f48-1df1-4fd2-d115" hidden="false" noindex="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit gains this ability, select two points in the battlefield within 16&quot; of this unit and mark those points. While this unit has this ability, after any of your units are Activated within 4&quot; of that point, you may remove your active unit from the battlefield and place it into reserves. Then, Deploy your active unit wholly within 6&quot; of the other selected point.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Farseer Spirit Stone" id="a73b-cff7-f2ed-f0e7" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">This unit gains Psyker 3.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Vauls’ Blessing" id="428e-170c-f3ba-f8ae" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each melee attack made for this unit, that attack gains Critical Hits 5+. If the target unit of those attacks has Fatal Thread, reroll a Hit Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Faolchu’s Wing" id="9567-4b7f-ec24-af3d" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Attacks step, it may Reposition.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Exarch Spirit Stone" id="4192-00a1-633b-7b44" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each attack made for this unit, that attack gains Critical Hits 6+. Additionally, if this is your second turn in a row, for each attack made for the active unit this turn, reroll a Hit Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
