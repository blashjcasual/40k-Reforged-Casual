  <sharedProfiles>
    <profile name="Jet Bikes" id="e8ad-40cd-784f-fb45" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for this unit, add 1 D6 to that roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lightning Speed" id="981f-33b8-4f96-fa66" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After you make a Move Roll for this unit, you may discard the lowest result in that roll. If you do, until this unit is Activated or dies, it gains the following ability:</characteristic>
      </characteristics>
    </profile>
    <profile name="Windfall of the Warp, Seer Sight" id="83fb-1b38-71c1-49dd" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test has two or more dice with the same result, until the End step, for each attack made for this unit, add 1 the Hit Roll of that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Fleet Footwork" id="1367-65b6-5f27-116d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Attacks step, if one or more enemy units that were targeted by an attack made by this unit this turn had Fatal Thread, this unit may Reposition.</characteristic>
      </characteristics>
    </profile>
    <profile name="Windfall of the Warp: Guide Spirits" id="11c6-5f89-1569-6670" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test has two or more dice with the same result, until the End step, for each attack made for a weapon equipped to any WRAITHBLADE or WRAITHGUARD model, add 1 to the Hit Roll of that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Windfall of the Warp: Certain Death" id="cee7-b7cf-d712-cc0b" hidden="false" typeId="266a-be4d-b9fa-94de" typeName="Windfall of the Warp">
      <characteristics>
        <characteristic name="Psychic Power" typeId="9060-973c-99e9-75b4">After this unit makes a Psychic Test, if that Psychic Test had two or more dice with the same result, each enemy unit on the battlefield gains Fatal Thread until the End of the next turn.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Roaming Performers" id="c56f-e048-3acd-ec3d" hidden="false">
      <description>You may add one of the following Harlequins units to your Army


List:
● TROUPE MASTER
● SHADOWSEER
and one of either:
● LIGHT TROUPE
● DARK TROUPE
● TWILIGHT TROUPE


If you do add one or more of those units to your Army List, your Army Rules gains Mocking Misstep, Allegro Advance, Prismatic Pirouette and Kaleidoscopic Cavalcade.</description>
    </rule>
    <rule name=" Aspect (X)" id="9db0-7796-725a-f91f" hidden="false">
      <description>While this unit is ready, after each of your End steps, if this was not your second turn in a row, you may take another turn. If you do, you must select a unit with Aspect Warrior to activate that turn.</description>
    </rule>
    <rule name="Eyes of the Asuryani" id="3be3-6578-1b0d-7468" hidden="false">
      <description>While this unit is not active, enemy units visible to this unit gain the following ability:

Fatal Thread: For each attack made by an Aeldari Craftworlds unit that targets this unit, a Hit Roll of 6 for that attack always wounds.</description>
    </rule>
  </sharedRules>
