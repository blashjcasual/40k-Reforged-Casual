      <profiles>
        <profile name="Preternatural Skill" id="17cb-5699-3f07-50b0" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each ranged attack this unit makes, which targets an enemy unit further than 16&quot; away from this unit, reroll a Hit Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Path of the Outcast" id="6418-1756-58c6-0c46" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any enemy unit&apos;s Move step, as a reaction, if the active unit is within 24&quot; of and visible to this unit, you may roll a D6. On a 5+, this unit Repositions. During that Reposition, this unit&apos;s models may ignore vertical distances.</characteristic>
          </characteristics>
        </profile>
      </profiles>
