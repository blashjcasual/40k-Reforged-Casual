      <profiles>
        <profile name="Waystone Clutches" id="a33a-6f9a-696d-8089" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Move step, if it is within 4&quot; of the centre point of a vault, you may roll 1 D6. Then select one of your units and it gains the relic which matches the result. Any other friendly unit with that relic loses it.</characteristic>
          </characteristics>
        </profile>
        <profile name="Clarity of Thought" id="e802-d71a-a196-e9ac" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
