    <selectionEntry name="Psychic Powers (Reference)" id="cb57-8ddf-8547-48b1" hidden="false" import="true" sortIndex="-4" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="cd84-103a-aa64-1bca" hidden="false" primary="true" targetId="9cd6-0442-3f35-6b52"/>
      </categoryLinks>
      <constraints>
        <constraint id="7e06-c05a-ba1c-8d45" field="selections" includeChildSelections="false" scope="force" shared="true" type="max" value="1"/>
        <constraint id="9c5f-b27e-383d-cd5f-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="9c5f-b27e-383d-cd5f-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="1. Song of Souls" id="5661-15c3-120e-477f" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a friendly unit in the battlefield. The selected unit may Reposition. Then, the selected unit Heals 1. If that unit has Wraithbone, it Heals D3 instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="2. Webway Leap" id="ac7f-83f6-9d25-2ea0" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one of your other infantry units in the battlefield. Remove that unit from the battlefield and place it into reserves. Then, Deploy that unit wholly within 6&quot; of this unit, outside of the engagement range of enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="3. Combinatorial Foresight" id="e5c9-9797-3640-40c2" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, after a model in a friendly unit within 12&quot; of and visible to this unit is selected to suffer a wound, roll a D6. On a 6, the Saving Throw for that attack always succeeds.</characteristic>
          </characteristics>
        </profile>
        <profile name="4. Eldritch Bolt" id="4d29-91e4-ba19-e9ab" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select one unit within 16&quot; of and visible to this unit. That unit suffers 4+2D3 SW.</characteristic>
          </characteristics>
        </profile>
        <profile name="5. Eldritch Storm" id="d24c-86a1-6524-c6a0" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select one point in the battlefield within 16&quot; of this unit. All units within 2D6&quot; of that point each suffer 3 SW.</characteristic>
          </characteristics>
        </profile>
        <profile name="6. Battle Meditations" id="d934-e5eb-df8a-5194" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the next time this unit is Activated or dies, each time a model in a friendly unit within 12&quot; of and visible to this unit makes a Move Roll, you may roll 6+D6 for that instead of 2D6.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
