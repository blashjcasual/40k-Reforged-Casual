          <modifiers>
            <modifier field="name" type="set" value="Aspect (Warp Spider)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Aggressive Defence" id="0850-b0eb-beeb-769e" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Attacks step, if an enemy unit was destroyed this turn, this unit may Advance.</characteristic>
          </characteristics>
        </profile>
        <profile name="Flickerjump" id="6232-4d13-e751-1939" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">If this unit would Advance, you may instead use&apos;flickerjump&apos;. If you do, you may remove this unit from the battlefield and place it into reserves. Then, roll a D6. On a 1, this unit dies. Otherwise, Deploy it anywhere in the battlefield outside of the engagement range of enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hunter’s Snare" id="22ad-0d0a-fa67-ff48" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated, select an enemy unit not visible to this unit. Until the End step, for each attack that targets the selected unit, add 1 to the Hit Roll of that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
