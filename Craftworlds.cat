      <profiles>
        <profile name="Path of Command" id="f16e-5f4d-05e7-4e6d" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any of your units with Aspect Warriors Activate, you may select an enemy unit visible to one or more friendly units with Eyes of the Asuryani. If you do, until the End step, that friendly unit gains Fluid Grace, and that enemy unit gains Graceless Foes.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fluid Grace" id="a8df-342c-8d89-4a7b" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">During this unit&apos;s Move step, for each Move Roll made for this unit, add 2D6 to that roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Graceless Foes" id="0f31-e3d6-2da6-5243" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack made targeting this unit, reroll a Hit Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Paths" id="a893-66a5-1a4b-af00" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit may attach to any unit with Aspect Warriors.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Autarch" id="e7bf-e9f2-6ac1-4265" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="e7bf-e9f2-6ac1-4265-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
