        <infoLink name="Shield Drone" id="862d-0e1b-ac01-db6e" hidden="false" targetId="e51d-8c9d-76ff-f5ba" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="1 Shared Vision Lens" id="48fc-ce52-0489-d5f9" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s End step, if this turn was your first turn in a row, you may take another turn. If you do, during that turn, for each Hit Roll made by the unit you Activate, reroll a failed Hit Roll for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Orbital Rangefinder" id="015e-ecf0-0464-a5aa" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">Each time this unit selects a target for a ranged weapon, you may select an enemy unit with Marked an additional 4&quot; away.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Holographic Decoys" id="ebd1-9305-59c9-c256" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After any enemy unit&apos;s Move step, as a reaction, if that enemy unit is within 24&quot; of and is visible to this unit, roll a D6. On a 5+, this unit may Reposition.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Puretide Engram Chip" id="de81-8cd3-57af-3c6d" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each ranged attack made by this unit that targets an enemy unit with Marked, that attack gains Critical Hits 5+.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Targeting Telemetry" id="6083-786b-5732-910a" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each ranged attack made by this unit that targets an enemy unit with Marked, that attack gains Critical Hits 6+ and Critical Wound 6+.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Counterfire Defence System" id="d78f-5874-cfd2-d6ad" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After the Move step while an enemy unit is active and visible to this unit, you may roll a D6. On a 5+, this unit makes ranged attacks targeting that enemy unit (if able).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
