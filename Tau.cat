          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Move step, select a visible enemy unit. The selected unit gains Marked until the End step.</characteristic>
          </characteristics>
        </profile>
        <profile name="Devastating Unity" id="0b02-1078-8630-1986" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack made by this unit or your STRIKE TEAM or BREACHER TEAM units within 24&quot; and visible to this unit, that attack gains Critical Hits 6+. Each attack may only benefit from Devastating Unity once.</characteristic>
          </characteristics>
        </profile>
        <profile id="f618-9c09-fe0c-e287" hidden="false" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit must attach to either:
a) STRIKE TEAM
b) BREACHER TEAM</characteristic>
          </characteristics>
        </profile>
