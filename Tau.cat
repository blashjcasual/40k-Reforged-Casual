  <sharedProfiles>
    <profile name="Markerlights" id="1f6c-1316-7984-a1b7" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While enemy units are visible to this unit while this unit is not active, those enemy units gain the following ability:

Marked: For each ranged attack made by a T’au unit that targets this unit, add 1 to the Hit Roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Support Turrets" id="5bd5-af4f-e95c-c787" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After rolling for initiative in battle round 1, create a unit of SUPPORT TURRETS within 4&quot; of your deployment zone with X models where X is equal to the number of STRIKE TEAM and BREACHER TEAM units in your Army List. SUPPORT TURRETS (X) - Infantry T Sv H Rv 4 5+ 2 6+ Heavy Armour</characteristic>
      </characteristics>
    </profile>
    <profile name="Support Turrets (X)" id="5cba-7d53-2abe-ca28" hidden="false" typeId="a706-96eb-fcae-b696" typeName="Unit">
      <characteristics>
        <characteristic name="T" typeId="a6ad-d820-8495-f5b0">4</characteristic>
        <characteristic name="Sv" typeId="9b7f-0dde-683f-6844">5+</characteristic>
        <characteristic name="H" typeId="18e4-1bf9-a9b8-1e50">2</characteristic>
        <characteristic name="Rv" typeId="411f-3942-6dc0-7c06">6+</characteristic>
      </characteristics>
    </profile>
    <profile name="Saviour Protocols" id="a2e0-3e1a-f7ee-8d04" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While there are one or more&apos;drone&apos;models in your units, for each wound a model in those units is selected to suffer, after you roll a Saving Throw of 1, you may use&apos;saviour protocols&apos;. If you do, one drone model from that unit dies and reroll that Saving Throw.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shield Drone" id="e51d-8c9d-76ff-f5ba" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit has one or more SHIELD DRONE or SHIELDED M ISSILE DRONE models, after a model in this unit is selected to suffer a wound, roll a D6. On a 5+, the Saving Throw for that wound always succeeds.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tactical Acumen" id="af1a-cb44-c903-3f73" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While enemy units are within 24” of this unit, those units gain the following ability:

Mont’ka: For each attack made by a T’au unit that targets this unit from within 24”, reroll a Wound Roll of 1 for that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Kauyon" id="ee8f-2ea5-7ee4-36f1" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Attacks step, if one or more enemy units that were targeted by an attack made by this unit this turn had Marked, this unit may Reposition. If it does, that move must end further away from the closest enemy unit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cloaking Fields" id="f463-4e5e-23a4-da1e" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets this unit, that attack&apos;s Hit Roll is worsened by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Long Range Patrol" id="b016-f22f-de10-a883" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s End step, if this turn was your first turn in a row, take another turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Stealth Fields" id="80fd-57e0-6bad-98b5" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each ranged attack that targets this unit, the Hit Roll of that attack is worsened by 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Targeting Array" id="38e8-946d-71f8-4218" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each ranged attack made for this unit that targets an enemy unit with Marked, reroll a Hit Roll of 1 for that attack.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Marked" id="70a4-a7cf-d04d-e951" hidden="false">
      <description>For each ranged attack made by a T&apos;au unit that targets this unit, add 1 to the Hit Roll of that attack.</description>
    </rule>
    <rule name="Pulse" id="f151-f63e-48b8-7823" hidden="false">
      <description>For each attack made for this weapon, add 1 to the Wound Roll of that attack.</description>
    </rule>
  </sharedRules>
