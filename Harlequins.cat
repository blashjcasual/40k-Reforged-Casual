                  <profiles>
                    <profile name="Prismatic Cannon (Strike)" id="e798-09a0-608c-f8bd" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">Aslt</characteristic>
