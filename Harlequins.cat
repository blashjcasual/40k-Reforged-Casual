                      </characteristics>
                    </profile>
                    <profile name="Prismatic Cannon (Sweep)" id="7633-3bdb-954f-04c1" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">Aslt</characteristic>
                        <characteristic name="A" typeId="13c5-f234-c120-afc3">12</characteristic>
                        <characteristic name="WS" typeId="459f-6890-e77f-b62f">2+</characteristic>
                        <characteristic name="S" typeId="571c-0471-2614-c57c">4</characteristic>
