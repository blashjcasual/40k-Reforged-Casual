              </infoLinks>
              <modifiers>
                <modifier affects="b9b5-f1c5-28fb-b674" field="name" scope="unit" type="prepend" value="Light"/>
              </modifiers>
              <profiles>
                <profile name="Light" id="487d-3c17-ec4f-858c" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 24” of and visible to any enemy units, this unit gains Resilient 5+.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Bold Performance" id="1a61-dfc1-1ed9-8cd7" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 24&quot; of and visible to any enemy units, for each roll for Mocking Misstep for visible friendly units, that roll is successful on a 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dark" id="c3d2-169d-cd8e-8d3c" hidden="false" import="true" sortIndex="3" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <modifiers>
                <modifier affects="b9b5-f1c5-28fb-b674" field="name" scope="unit" type="prepend" value="Dark"/>
              </modifiers>
              <profiles>
                <profile name="Dark" id="3c73-503a-d39b-e065" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit Activates, all enemy units not visible to this unit gain the following ability until the End step:

Captive Audience: For each attack that targets this unit, a Hit Roll of 5+ for that attack causes an additional hit.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Devious Performance" id="de1d-8e12-9547-2ea5" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While there is an enemy unit within 24&quot; of and not visible to this unit, for each roll for Mocking Misstep for visible friendly units, that roll is successful on a 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Twilight" id="dd46-d8eb-9a92-1e86" hidden="false" import="true" sortIndex="2" type="upgrade">
              <modifiers>
                <modifier affects="b9b5-f1c5-28fb-b674" field="name" scope="unit" type="prepend" value="Twilight"/>
              </modifiers>
              <profiles>
                <profile name="Changeable Performance" id="3fa3-a8ab-ec6b-9e81" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 2&quot; of a terrain piece, for each roll for Mocking Misstep for visible friendly units, that roll is successful on a 5+.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Twilight" id="f3c1-2187-f5a1-1521" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 2” of a terrain piece, for each roll for Mocking Misstep for this unit, improve that roll by 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
