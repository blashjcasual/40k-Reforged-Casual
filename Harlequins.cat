<catalogue name="Harlequins" id="5f5e-53b8-b4af-9b92" battleScribeVersion="2.03" gameSystemId="sys-c49b-9f87-36f1-c9b5" gameSystemRevision="10" library="false" revision="34" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <entryLinks>
    <entryLink name="Troupe" id="8ae4-8629-fe9d-73a2" hidden="false" sortIndex="3" targetId="b9b5-f1c5-28fb-b674" type="selectionEntry"/>
  </entryLinks>
  <selectionEntries>
    <selectionEntry name="Army Abilities" id="3e4b-29af-4da8-2435" hidden="false" import="true" sortIndex="-2" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="0760-2d2e-bb87-c895" primary="true" targetId="9cd6-0442-3f35-6b52"/>
      </categoryLinks>
      <constraints>
        <constraint id="5ef3-7421-f11f-96ec" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Mocking Misstep" id="93f2-8278-f866-f23e" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After any enemy unit&apos;s Move step, as a reaction, you may select one of your Harlequins units that is visible to that enemy unit. If you do, roll a D6. On a 6+, the roll is successful and the selected unit may Reposition.</characteristic>
          </characteristics>
        </profile>
        <profile name="Kaleidoscopic Cavalcade" id="9280-5f03-55b2-37aa" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets your Harlequins units, the Hit Roll for that attack is worsened by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Prismatic Pirouette" id="e5f5-f88d-4326-e279" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Your Harlequins units may move over enemy units and terrain as if they were not there. During your turns, if any of your Harlequins units would Reposition, that unit may Advance instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cegorach’s Jest" id="b0fe-1497-b8f4-1287" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">after a Harlequins model suffers a wound from SW caused by a psychic power, roll a D6; on a 5+, the Saving Throw for that attack always succeeds</characteristic>
          </characteristics>
        </profile>
        <profile name="Allegro Advance" id="a1be-638c-c5e6-4fa7" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for your Harlequins units, roll an additional D6 and discard the lowest dice for that roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Relics (Reference)" id="b58a-ba1e-7fbf-a030" hidden="false" import="true" sortIndex="-4" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="d52a-2a89-96ed-2398" hidden="false" primary="true" targetId="9cd6-0442-3f35-6b52"/>
      </categoryLinks>
      <constraints>
        <constraint id="2210-dc7d-4951-de68" field="selections" includeChildSelections="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="2 Blinded Damsel" id="3c0c-9a15-b526-32e0" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After a model in this unit is selected to suffer a wound, roll a D6. On a 5+, the Saving Throw for that wound always succeeds.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Curtain’s Fall" id="8429-07bd-099c-7883" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">Each time you roll a D6 for Mocking Misstep for this unit, you may reroll the result. After this unit finishes a Reposition, if it had Stuck In, it does not lose it.</characteristic>
          </characteristics>
        </profile>
        <profile name="1 Webway Virtuosos" id="0623-7726-9761-14f3" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit is Activated, you may remove it from the battlefield and place it into reserves. Then roll 3D6. You may Deploy it anywhere in the battlefield at least X&quot; away from enemy units where X is the result of that roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 She Who Thirsts" id="ef77-efcd-11e5-863b" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, you may&apos;mime the Dark Prince&apos;. If you do, select an enemy unit within 16&quot; of and visible to this unit. After the Attacks step, if an enemy unit died this turn, this unit may Reposition. Then, the selected unit suffers 4+D6 Suppression.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Damned Nemesis" id="db57-93b0-d96a-fab2" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each melee attack made by this unit, that attack gains Critical Hits 5+. If that attack targets a chaos unit, reroll each Wound Roll of 1 for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Cegorach’s Favour" id="c057-fd2c-7b76-5731" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After any enemy unit&apos;s Move step, as a reaction, you may roll a D6. On a 5+, this unit may Reposition. After this unit finishes a Reposition, if it had Stuck In, it does not lose it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Psychic Powers (Reference)" id="209a-4a6e-d552-b2a7" hidden="false" import="true" sortIndex="-3" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="e934-bae6-7d8e-d7dd" hidden="false" primary="true" targetId="9cd6-0442-3f35-6b52"/>
      </categoryLinks>
      <profiles>
        <profile name="1 Fog of Dreams" id="0578-61a0-1ecd-0580" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy infantry or monster unit within 16&quot; of this unit. The selected unit suffers 2+D3 Suppression and until the end of the battle round, the selected unit can only select targets within 8&quot; of it for its attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Veil of Tears" id="93a3-8842-0595-366c" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a friendly infantry unit within 16&quot; of this unit. Until the next time this unit is Activated or dies, the selected unit gains the following ability:</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Mind Labyrinth" id="b94c-446b-99fe-0bf3" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy unit within 16&quot; of and visible to this unit. The selected unit suffers 2+D3 Suppression. Then, until the next time this unit is Activated, each of the selected unit&apos;s Move Rolls is worsened by X where X is equal to the Suppressed X it has.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Dance of Shadows" id="d10d-b877-23c7-b19f" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the end of the battle round, for each ranged attack an enemy unit makes targeting this unit or a friendly infantry unit within 3&quot; of this unit, each Wound Roll for that attack is only successful on a 4+.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Shards of Light" id="3f47-d72d-e8f8-08bd" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, select up to 3 different enemy units within 16&quot; and visible to this unit. Each selected unit suffers D3+2 SW.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Peal of Discord" id="69f4-0e41-f527-e5d3" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">After you would select targets for this unit this turn, roll 2+D3. Then, each enemy unit within 8&quot; of this unit suffers X Suppression and X SW where X is equal to that roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
