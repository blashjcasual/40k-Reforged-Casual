          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Light" hidden="false" id="a289-af52-5c51-695a" sortIndex="1">
              <infoLinks>
                <infoLink name="Resilient (X)" id="5d38-3e8d-6cc5-702e" hidden="false" type="rule" targetId="253c-c1fa-d29d-d21e" />
              </infoLinks>
              <profiles>
                <profile name="Light" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="487d-3c17-ec4f-858c">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 24” of and visible to any enemy units, this unit gains Resilient 5+.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Bold Performance" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="1a61-dfc1-1ed9-8cd7">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 24" of and visible to any enemy units, for each roll for Mocking Misstep for visible friendly units, that roll is successful on a 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="10" />
              </costs>
              <modifiers>
                <modifier type="prepend" value="Light" field="name" affects="b9b5-f1c5-28fb-b674" scope="unit" />
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dark" hidden="false" id="c3d2-169d-cd8e-8d3c" sortIndex="3">
              <profiles>
                <profile name="Dark" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="3c73-503a-d39b-e065">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit Activates, all enemy units not visible to this unit gain the following ability until the End step:

Captive Audience: For each attack that targets this unit, a Hit Roll of 5+ for that attack causes an additional hit.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Devious Performance" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="de1d-8e12-9547-2ea5">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While there is an enemy unit within 24" of and not visible to this unit, for each roll for Mocking Misstep for visible friendly units, that roll is successful on a 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="10" />
              </costs>
              <modifiers>
                <modifier type="prepend" value="Dark" field="name" affects="b9b5-f1c5-28fb-b674" scope="unit" />
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Twilight" hidden="false" id="dd46-d8eb-9a92-1e86" sortIndex="2">
              <profiles>
                <profile name="Changeable Performance" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="3fa3-a8ab-ec6b-9e81">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 2" of a terrain piece, for each roll for Mocking Misstep for visible friendly units, that roll is successful on a 5+.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Twilight" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="f3c1-2187-f5a1-1521">
                  <characteristics>
                    <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is within 2” of a terrain piece, for each roll for Mocking Misstep for this unit, improve that roll by 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <modifiers>
                <modifier type="prepend" value="Twilight" field="name" affects="b9b5-f1c5-28fb-b674" scope="unit" />
              </modifiers>
            </selectionEntry>
          </selectionEntries>
