      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Protocol of the Sudden Storm" hidden="false" id="9aff-2329-c205-1c89" sortIndex="1">
          <costs>
            <cost name="pts" typeId="points" value="20" />
          </costs>
          <profiles>
            <profile name="Protocol of the Sudden Storm" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="c70b-0a7b-c4a0-1311">
              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is visible to a friendly Necron leader unit, add 1 D3 to Move Rolls made for this unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Protocol of the Vengeful Stars" hidden="false" id="33fb-2119-61dd-be66" sortIndex="2">
          <costs>
            <cost name="pts" typeId="points" value="20" />
          </costs>
          <profiles>
            <profile name="Protocol of the Vengeful Stars" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="b27c-48d0-aead-b13e">
              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is visible to a friendly Necron leader unit, each time this unit selects a target for a ranged weapon, you may select an enemy unit up to 2" further away.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Protocol of the Undying Legions" hidden="false" id="fa9c-22ef-1f80-4067" sortIndex="3">
          <costs>
            <cost name="pts" typeId="points" value="20" />
          </costs>
          <profiles>
            <profile name="Protocol of the Undying Legions" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="b7b5-b6d1-d237-f3b5">
              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is visible to a friendly Necron leader unit, each time this unit uses Living Metal, improve the result of the roll by 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
  <sharedProfiles>
    <profile name="Relentless March" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="0126-6cc7-c58a-5e6b">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Move Rolls made for this unit are 2D3 instead of 2D6.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dimensional Oubliette" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="0854-5237-1342-0789">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated in reserves, you may Deploy it anywhere in the battlefield outside of engagement range of enemy models. If you do, during this turn's Move step, do not make a Move roll and this unit cannot Advance or Reposition.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sentient Arcing" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="592c-3bb3-3093-ce73">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After selecting the target for this unit's Tesla Cannon or Twin Tesla Destructor, select up to one different enemy unit within 6" of and visible to the selected target. Also make attacks with that weapon targeting each of the selected units.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
</catalogue>