        <infoLink name="Fly" id="1126-423b-ac3c-5479" hidden="false" targetId="449b-2864-9b01-7476" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Optimised Swarm" id="b82c-a39f-8b20-3d18" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After a friendly CANOPTEK SCARAB SWARM is Activated within 6” of this unit, for that unit’s Scarab Subroutines, it may select both REPAIR and REPLICATE this turn instead of just one.</characteristic>
          </characteristics>
        </profile>
        <profile name="Spyder Subroutines" id="0bff-0913-71ce-71a9" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated, select one of the following abilities. Then, this unit gains the selected ability until the End step:

REPAIR: After this unit’s Move step, select one other unit with Living Metal within 4” of this unit. That unit uses Living Metal.

FABRICATE: After this unit’s Move step, if there is a friendly CANOPTEK SCARAB SWARM unit within 24&quot; of this unit, add 1 CANOPTEK SCARAB SWARM model to that unit. Otherwise, create a CANOPTEK SCARAB SWARM unit within 1” of this unit outside of the engagement range of enemy units with 1 model. That unit is ready.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gloom Prism" id="2652-95cf-c58c-97b6" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each SW from a psychic power or Windfall of the Warp ability which targets a friendly unit within 9&quot; of this unit, that unit gains Shield 6+ for that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Canoptek Spyder" id="25e2-41eb-b1b1-c3f1" hidden="false" import="true" sortIndex="1" type="model">
          <constraints>
            <constraint id="22d4-7c33-4892-2cd7-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
