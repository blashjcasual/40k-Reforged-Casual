          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After rolling for initiative, if this unit is in reserves you may Deploy it at least 3D6&quot; away from enemy units.</characteristic>
          </characteristics>
        </profile>
