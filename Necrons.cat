          <profiles>
            <profile name="Madness Virus" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="aa60-08c5-3d8d-807a">
              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">Once per battle, after this unit is Activated, you may'inject madness virus'. If you do, until the End step, for each attack this unit makes this turn, that attack suffers a -1 to its Hit Roll and gains Critical Hits 5+.</characteristic>
              </characteristics>
            </profile>
            <profile name="Plasmacyte Construct" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="32f1-46d4-296c-a6b7">
              <characteristics>
                <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit's CANOPTEK PLASM ACYTE model cannot be selected to suffer wounds. After the last non-CANOPTEK PLASM ACYTE model dies, this unit's CANOPTEK PLASM ACYTE model dies.</characteristic>
              </characteristics>
            </profile>
            <profile name="Canoptek Plasmacyte" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader" hidden="false" id="02aa-acff-9926-3e66">
              <characteristics>
                <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit must attach to:
a) Any unit with Destroyer Cults.

This unit may attach to a unit which already has an attached leader (other than another CANOPTEK PLASMACYTE).
This unit does not count towards your army list’s leader capacity.</characteristic>
              </characteristics>
            </profile>
