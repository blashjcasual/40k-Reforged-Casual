            <profile name="Canoptek Plasmacyte" id="02aa-acff-9926-3e66" hidden="false" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader">
              <characteristics>
                <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit must attach to:
a) Any unit with Destroyer Cults.

This unit may attach to a unit which already has an attached leader (other than another CANOPTEK PLASMACYTE).
This unit does not count towards your army list’s leader capacity.</characteristic>
              </characteristics>
            </profile>
            <profile name="Canoptek Plasmacyte" id="d3bc-0823-93b2-c4d0" hidden="false" typeId="a706-96eb-fcae-b696" typeName="Unit">
