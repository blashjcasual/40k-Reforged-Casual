      <profiles>
        <profile name="Dimensional Displacement" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="35be-a2ae-a6ec-ebdd">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated in reserves, you may use'dimensional displacement'. If you do, roll 3D6. Then, Deploy this unit anywhere in the battlefield at least X" away from all enemy units where X is the result of that roll. If you do, during this turn's Move step, do not make a Move roll and this unit cannot Advance or Reposition.</characteristic>
          </characteristics>
        </profile>
        <profile name="Whipcoil Movement" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="aaf7-1307-9ddc-0c45">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets this unit, the Hit Roll of that attack is worsened by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Canoptek Spyder" hidden="false" id="074d-4164-9a62-cbc0" sortIndex="22">
      <costs>
        <cost name="pts" typeId="points" value="100" />
      </costs>
      <profiles>
        <profile name="Optimised Swarm" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="b82c-a39f-8b20-3d18">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After a friendly CANOPTEK SCARAB SWARM is Activated within 6” of this unit, for that unit’s Scarab Subroutines, it may select both REPAIR and REPLICATE this turn instead of just one.</characteristic>
          </characteristics>
        </profile>
        <profile name="Spyder Subroutines" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="0bff-0913-71ce-71a9">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated, select one of the following abilities. Then, this unit gains the selected ability until the End step:

REPAIR: After this unit’s Move step, select one other unit with Living Metal within 4” of this unit. That unit uses Living Metal.

FABRICATE: After this unit’s Move step, if there is a friendly CANOPTEK SCARAB SWARM unit within 24" of this unit, add 1 CANOPTEK SCARAB SWARM model to that unit. Otherwise, create a CANOPTEK SCARAB SWARM unit within 1” of this unit outside of the engagement range of enemy units with 1 model. That unit is ready.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gloom Prism" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="2652-95cf-c58c-97b6">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each SW from a psychic power or Windfall of the Warp ability which targets a friendly unit within 9" of this unit, that unit gains Shield 6+ for that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <entryLinks>
        <entryLink import="true" name="Living Metal" hidden="false" id="31b9-3812-51f0-a4a2" type="selectionEntry" targetId="62c7-282f-8c64-69cf" />
