        <infoLink name="Ignore Cover" id="51d1-dccb-fc73-2962" hidden="false" type="rule" targetId="c88b-5cb0-aa9d-b742" />
        <infoLink name="Resilient (X)" id="83b5-ba11-a4b9-c6dd" hidden="false" type="rule" targetId="253c-c1fa-d29d-d21e" />
      </infoLinks>
