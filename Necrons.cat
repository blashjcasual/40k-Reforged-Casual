          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated in reserves, you may use&apos;dimensional displacement&apos;. If you do, roll 3D6. Then, Deploy this unit anywhere in the battlefield at least X&quot; away from all enemy units where X is the result of that roll. If you do, during this turn&apos;s Move step, do not make a Move roll and this unit cannot Advance or Reposition.</characteristic>
          </characteristics>
        </profile>
        <profile name="Whipcoil Movement" id="aaf7-1307-9ddc-0c45" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets this unit, the Hit Roll of that attack is worsened by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
