        <profile name="Dimensional Destabilisation Matrix" id="d992-6440-c0f5-f1a7" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is ready, it is treated as being not visible to all enemy units. Additionally, this unit may move through models and terrain as if they were not there.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wraith Subroutines" id="141c-494b-feb1-4f99" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit is Activated, select one of the following abilities. Then, this unit gains the selected ability until the End step:

SOW TERROR: After this unit’s Move step, each enemy unit within 8” of this unit suffers 1+D3 Suppression.

ISOLATE INTRUDER: For each melee attack this makes, that attack gains Isolate and Shred.</characteristic>
          </characteristics>
        </profile>
      </profiles>
