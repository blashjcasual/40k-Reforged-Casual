          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">During an Advance, this unit may move up to an additional 6" if that move would end within 1" of a friendly infantry unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Royal Guard" typeId="e9b6-89e0-ffee-5662" typeName="Ability" hidden="false" id="a16a-9719-d70f-fe6e">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While other infantry units are within 1" of this unit, if this unit is visible to an active enemy unit and closer or equally distant to that enemy unit, those friendly infantry units gain the following ability:</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
