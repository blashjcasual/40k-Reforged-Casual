      </infoLinks>
      <profiles>
        <profile name="Mantle of Contagion" id="b582-6048-4ac0-c42a" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each melee attack made by your units which target an enemy unit within 21&quot; of this unit, reroll a failed Hit Roll for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile id="7253-8437-9cf1-9aa1" hidden="false" typeId="55da-e0a0-1fa3-2d1c" typeName="Leader">
          <characteristics>
            <characteristic name="Must Attach to" typeId="2c63-5e3f-9132-459d">This unit cannot attach to anything.</characteristic>
          </characteristics>
