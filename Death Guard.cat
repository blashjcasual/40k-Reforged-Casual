          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">This unit cannot be in cover for enemy attacks. This unit&apos;s T is improved by 1 (already noted in bold). For each SW this unit suffers, instead add 1 to Resilient Rolls for that attack.</characteristic>
          </characteristics>
          <modifiers>
            <modifier affects="self.entries.recursive.profiles.Unit" field="a6ad-d820-8495-f5b0" scope="unit-self" type="increment" value="1"/>
          </modifiers>
