    <selectionEntry name="Psychic Powers (Reference)" id="aa32-ae3b-7939-cce1" hidden="false" import="true" sortIndex="-3" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="6a37-e6d0-5cea-f4c5" hidden="false" primary="true" targetId="9cd6-0442-3f35-6b52"/>
      </categoryLinks>
      <constraints>
        <constraint id="6135-94e8-b462-bd67" field="selections" includeChildSelections="false" scope="force" shared="true" type="max" value="1"/>
        <constraint id="5b6b-e374-f855-1414" field="selections" includeChildSelections="false" scope="force" shared="true" type="min" value="1"/>
        <constraint id="14b8-80b4-c165-f1cd" field="selections" includeChildSelections="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <infoLinks>
        <infoLink name="Suppressive (X)" id="8ed9-cf1a-2baa-0078" hidden="false" targetId="aed3-e154-8fa2-5378" type="rule"/>
        <infoLink name="Resilient (X)" id="b304-9670-943c-b044" hidden="false" targetId="253c-c1fa-d29d-d21e" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="1 Putrid Miasma" id="f5f3-5aaa-ce96-b226" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one friendly unit within 14&quot; of this unit. Until the next time this unit is Activated or dies, for each ranged attack that targets the selected unit, that attack has its Hit Roll worsened by 1. Attacks cannot be affected by this psychic power more than once.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Blighted Pathogens" id="440d-3cb4-6bfd-c916" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select a point in the battlefield within 21&quot; of this unit. Until the next time this unit is Activated or dies, for each attack made by your units that target enemy units within 14&quot; of the selected point, reroll failed Wound Rolls for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Gift of Contagion" id="e894-0d5a-083d-c75b" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one enemy unit within 14&quot; of this unit. Then, that unit and each enemy unit within 7&quot; of that unit suffer X Suppression equal to the selected unit&apos;s Suppression X.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Curse of the Leper" id="6a08-bd43-c199-35cb" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select an enemy unit within 14&quot; of this unit. The selected unit suffers 4+D6 Suppression.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Bubotic Vitality" id="bf41-f1d8-6eea-f888" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Until the end of the next time this unit is Activated or dies, while your units are within 14” of this unit, you may reroll Move Rolls made for those units.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Path of the Plaguebearers" id="129f-7968-3d0c-6958" hidden="false" typeId="6406-cf2b-ec5b-c7e6" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Description" typeId="4b9e-dc73-b312-b42d">Select one friendly unit within 14&quot; of this unit. Then, the selected unit may Advance and during that move it may move through enemy units and terrain as if they were not there.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Relics (Reference)" id="7f88-9d0a-6c6c-3631" hidden="false" import="true" sortIndex="-4" type="upgrade">
