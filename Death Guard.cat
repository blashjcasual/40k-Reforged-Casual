  <sharedProfiles>
    <profile name="Festering Advance" id="944e-46dd-e901-73d1" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each Move Roll made for your units, for each D6 of that roll, roll a D3 instead. After you make a Move Roll for one of your units, that unit gains the following ability until the next time it is Activated:</characteristic>
      </characteristics>
    </profile>
    <profile name="Nurgle’s Gifts" id="1d15-546a-3644-21db" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While enemy units are within 7” of your units, those enemy units gain the following ability:

Nurgle’s Fruit: For each attack that targets this unit, if the weapon for that attack has Plague or Putrid, reroll a Wound Roll of 1 for that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Nurgle’s Fruit" id="2bc0-64a5-bf4e-b19c" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">For each attack that targets this unit, if the weapon for that attack has Plague or Putrid, reroll a Wound Roll of 1 for that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Plaguebringers" id="1678-14a0-a939-cba2" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is in the battlefield, the range of Nurgle&apos;s Gifts is improved by 7&quot;.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rustplate Resilience" id="f608-9c5b-d98a-6032" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
      <characteristics>
        <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While your units are within 21&quot; of this unit, those units gain Resilient 6+. If those units are a Death Guard unit, they gain the following ability instead:</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Plague" id="7985-d278-b6c4-f53e" hidden="false">
      <description>This weapon has Suppressive X where X is equal to this weapon&apos;s Damage.</description>
    </rule>
    <rule name="Putrid" id="5262-b1f5-26c7-19b6" hidden="false">
      <description>For each attack made by this weapon, add 1 to the Wound Roll of that attack. Additionally, if the target of that attack has Nurgle&apos;s Fruit, that attack gains Critical Wounds 6+.</description>
    </rule>
  </sharedRules>
