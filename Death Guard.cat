          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit dies, select a destroyed POXW ALKERS unit and roll a D6. On a 5+, put that unit in reserves with full Health and ready.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wailing Despair" id="c564-52df-c8b4-e6c0" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Move step, all enemy units within 7&quot; suffer 7+2D3 Suppression.</characteristic>
          </characteristics>
        </profile>
      </profiles>
