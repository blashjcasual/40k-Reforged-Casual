        <constraint id="e557-7441-9091-bac6" field="selections" includeChildSelections="false" scope="force" shared="true" type="max" value="1"/>
      </constraints>
      <infoLinks>
        <infoLink name="Suppressive (X)" id="4098-dbe8-9e9a-4e6a" hidden="false" targetId="aed3-e154-8fa2-5378" type="rule"/>
        <infoLink name="Putrid" id="247f-288a-97bc-9f04" hidden="false" targetId="5262-b1f5-26c7-19b6" type="rule"/>
        <infoLink name="Indirect" id="5a36-d20e-71b1-32f5" hidden="false" targetId="4de2-ca68-9af9-1b10" type="rule"/>
        <infoLink name="Barrage" id="5d6e-9196-06a2-f588" hidden="false" targetId="9cfc-06e3-74c6-ad83" type="rule"/>
        <infoLink name="Blast (X)" id="77a3-cc18-1795-31cb" hidden="false" targetId="308a-e96e-90f7-855e" type="rule"/>
        <infoLink name="Resilient (X)" id="367c-4e46-39c1-498b" hidden="false" targetId="253c-c1fa-d29d-d21e" type="rule"/>
        <infoLink name="Plague" id="74ae-a82b-058b-4960" hidden="false" targetId="7985-d278-b6c4-f53e" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="1 Sigil of Decay" id="7abc-0ab4-73fe-c47e" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While enemy units are within 14&quot; of this unit, the T of those units is worsened by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Tolling Bell" id="f8fe-0314-3589-cffd" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, all enemy units within 14&quot; of this unit suffer D3+1 SW. For each of those units that have Suppressed, that unit suffers 2D3+1 SW instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Pustulent Bombardment" id="bab7-714b-4fe4-0b84" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit is Activated, select one model in this unit. Until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Cornucopia of Corruption" id="5664-e1ae-fac5-44ac" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, roll 2+D3. Then, all enemy units within 7&quot; of this unit suffer X Suppression and X SW where X is equal to that roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Rancid Munitions" id="2c28-da20-4303-09e5" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each attack made for this unit, that attack gains Putrid. If it already has Putrid, that attack gains Critical Wounds 5+ instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Plague Skull of Glothila" id="05b2-650f-a77f-1134" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit is Activated, select one model in this unit. Until the End step, the selected model gains the following weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Plague Skull of Glothila (Weapon)" id="c1cf-fe3d-c80b-4223" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">CQ</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">1</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">2+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">5</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">1</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Blast 7, Putrid, Plague, Indirect</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Pustulent Bombardment" id="504a-e6f3-0a39-5c54" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">Hv</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">1</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">4+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">7</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">1</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Barrage, Blast 3, Putrid, Plague, Indirect</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
