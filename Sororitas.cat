    <selectionEntry name="Hospitaller" id="5a90-b3ad-8eef-a524" hidden="false" import="true" sortIndex="10" type="unit">
      <categoryLinks>
        <categoryLink name="Elites" id="f48b-9bf7-a24b-ae00" primary="true" targetId="4820-e2b5-9e00-bb68"/>
        <categoryLink name="Infantry" id="5d7a-41c9-dfa6-d1bc" primary="false" targetId="205c-3072-067b-d808"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="40"/>
      </costs>
      <profiles>
        <profile name="Last Rites" id="05c2-b8a9-5d79-2465" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After each time one of your units fails an Act of Faith roll, for the rest of the battle, add 1 to the D3 roll for this unit&apos;s Mobile Triage ability.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mobile Triage" id="c672-9cef-73da-2291" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit&apos;s Move step, roll a D3. Then, for a number of times equal to the result of that roll, select a friendly infantry unit within 12&quot; of this unit, and that unit Heals 1. If you do, skip the Attacks step this turn and if this was your first turn in a row, after the End step, take another turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Hospitaller" id="c352-a610-f42d-cc93" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="99e1-fb5a-7f0a-73e4-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="99e1-fb5a-7f0a-73e4-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
