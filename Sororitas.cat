            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Blast 3, Ignore Cover, Holy Trinity</characteristic>
          </characteristics>
        </profile>
        <profile name="Saintly Multi-Melta" id="5ecf-1d76-f722-4751" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">Aslt</characteristic>
