      <profiles>
        <profile name="1 Martyrs Blood" id="c278-37f0-982f-c838" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit&apos;s Move step, select any melee weapon in this unit. Then, until the End step, for each H this unit is missing, add 1 to the A of the selected weapon.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 Casket Of Penance" id="f98b-55e0-ab1b-c547" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While enemy units are within 8&quot; of this unit, for each attack made by your units which target those enemy units, add 1 to the Hit Roll of that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 Laud-Hailer Organ" id="e261-9cce-56a8-b3a3" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">While friendly units are within 12&quot; of this unit, add 1 to Resolve Tests made for those units. After this unit&apos;s Move step, all enemy units within 12&quot; suffer D3+1 Suppression.</characteristic>
          </characteristics>
        </profile>
        <profile name="4 Quicksilver Veil" id="0e00-6e49-e886-62b4" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">Add 1 D6 to Move Rolls made for this unit. For each attack that targets this unit, add 1 to Resilient Rolls for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="6 Saintly Relics" id="c7f7-80d2-f0aa-97b9" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">After this unit gains this unit ability, select one of the weapons below. While this unit has this ability, after this unit is Activated, select a model in this unit. Then, until the End step, the selected model gains the selected weapon:</characteristic>
          </characteristics>
        </profile>
        <profile name="5 Creed Annunciation" id="10b4-c80d-2a27-9c50" hidden="false" typeId="9b56-9768-f88b-14ac" typeName="Relics">
          <characteristics>
            <characteristic name="Description" typeId="becf-f398-aed2-688b">For each attack this unit makes for a weapon with Holy Trinity, that attack gains Critical Hits 5+.</characteristic>
          </characteristics>
        </profile>
        <profile name="Saintly Heavy Bolter" id="719c-db2f-b2ce-b065" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">Hv</characteristic>
            <characteristic name="A" typeId="13c5-f234-c120-afc3">15</characteristic>
            <characteristic name="WS" typeId="459f-6890-e77f-b62f">3+</characteristic>
            <characteristic name="S" typeId="571c-0471-2614-c57c">3</characteristic>
            <characteristic name="D" typeId="c2c0-3714-05e2-65a0">2</characteristic>
            <characteristic name="Abilities" typeId="d93f-70ee-72bc-5ef9">Holy Trinity</characteristic>
          </characteristics>
        </profile>
        <profile name="Saintly Flamer" id="7514-e404-c6d6-015e" hidden="false" typeId="2dff-53d0-6d25-8c59" typeName="Weapon">
          <characteristics>
            <characteristic name="Tp" typeId="6c1c-7d1d-c8b0-33ec">CQ</characteristic>
