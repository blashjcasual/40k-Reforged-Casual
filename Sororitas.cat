        <profile name="Shrine to the God-Emperor" id="e154-c81d-9081-377b" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While this unit is in the battlefield, the X of Choir of the Faithful X&quot; is improved by 4&quot;.</characteristic>
          </characteristics>
        </profile>
        <profile name="Artillery Support" id="442a-236d-f4f6-eae6" hidden="false" typeId="e9b6-89e0-ffee-5662" typeName="Ability">
          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">While selecting targets for this unit&apos;s Exorcist Missile Launcher, if you have no ready units except units with Artillery Support, you may&apos;call for an artillery strike&apos;. If you do, you may instead target an enemy unit within 24&quot; of and visible to any of your infantry units within 16&quot; of this unit. Additionally, for each attack made for that weapon this turn, add 1 to the Hit Roll of that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
