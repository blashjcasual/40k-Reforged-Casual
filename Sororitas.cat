          <characteristics>
            <characteristic name="Description:" typeId="22b9-735d-71b1-6d7a">After this unit dies, before removing it from the battlefield, it may select targets for its weapons, targeting only the closest visible enemy unit, and make attacks for those weapons.</characteristic>
          </characteristics>
        </profile>
